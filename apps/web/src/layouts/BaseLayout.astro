---
import "mana-font/css/mana.css";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-site-theme="default" data-mana-palette="classic">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const headerStorageKey = "future-sight-header-mana";
        const headerPreferenceKey = "future-sight-session-color";
        const headerManaColors = ["white", "blue", "black", "red", "green"];
        const siteThemeKey = "future-sight-site-theme";
        const siteThemes = ["default", "arcane", "parchment", "arena", "phyrexian", "kamigawa-neon", "high-contrast"];
        const expressiveThemes = ["arcane", "parchment", "arena", "phyrexian", "kamigawa-neon"];
        const manaPaletteKey = "future-sight-mana-palette";
        const manaPalettes = ["classic", "vivid", "soft"];

        let siteTheme = "default";
        try {
          const storedSiteTheme = window.localStorage.getItem(siteThemeKey);
          if (siteThemes.includes(storedSiteTheme)) {
            siteTheme = storedSiteTheme;
          }
        } catch {
          siteTheme = "default";
        }
        document.documentElement.dataset.siteTheme = siteTheme;

        let manaPalette = "classic";
        try {
          const storedManaPalette = window.localStorage.getItem(manaPaletteKey);
          if (manaPalettes.includes(storedManaPalette)) {
            manaPalette = storedManaPalette;
          }
        } catch {
          manaPalette = "classic";
        }
        document.documentElement.dataset.manaPalette = manaPalette;

        let headerPreference = "random";
        try {
          const storedHeaderPreference = window.localStorage.getItem(headerPreferenceKey);
          if (storedHeaderPreference === "random" || headerManaColors.includes(storedHeaderPreference)) {
            headerPreference = storedHeaderPreference;
          }
        } catch {
          headerPreference = "random";
        }

        let headerMana = null;
        if (headerManaColors.includes(headerPreference)) {
          headerMana = headerPreference;
          try {
            window.sessionStorage.setItem(headerStorageKey, headerMana);
          } catch {
            // Current page still receives the selected session color.
          }
        } else {
          try {
            headerMana = window.sessionStorage.getItem(headerStorageKey);
            if (!headerManaColors.includes(headerMana)) {
              headerMana = headerManaColors[Math.floor(Math.random() * headerManaColors.length)];
              window.sessionStorage.setItem(headerStorageKey, headerMana);
            }
          } catch {
            headerMana = headerManaColors[Math.floor(Math.random() * headerManaColors.length)];
          }
        }
        document.documentElement.dataset.headerMana = headerMana;
        document.documentElement.dataset.sessionColorMode = expressiveThemes.includes(siteTheme)
          ? "theme"
          : headerPreference === "random"
            ? "random"
            : "fixed";

        const storageKey = "future-sight-theme";
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        let storedTheme = null;
        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }
        if (storedTheme !== "dark" && storedTheme !== "light") {
          storedTheme = null;
        }
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img class="brand-logo" src="/logo.jpg" alt="" />
        <span>Future Sight</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/">Import Deck</a>
        <a href="/decks">Decks</a>
        <a href="/settings">Settings</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <button
      id="theme-randomize"
      class="theme-control theme-randomize"
      type="button"
      aria-label="Randomize session color theme"
      title="Randomize session color theme"
    >
      <span class="theme-control-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path
            d="M20 12a8 8 0 0 1-13.66 5.66 8 8 0 0 1 0-11.32A8 8 0 0 1 18 6.8V4h2v7h-7V9h3.82A6 6 0 1 0 18 12h2Z"
            fill="currentColor"
          />
        </svg>
      </span>
    </button>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
      <span class="theme-toggle-icon" aria-hidden="true"></span>
      <span class="theme-toggle-text">Dark</span>
    </button>
    <script is:inline>
      (() => {
        const storageKey = "future-sight-header-mana";
        const headerManaColors = ["white", "blue", "black", "red", "green"];
        const headerPreferenceKey = "future-sight-session-color";
        const siteThemeKey = "future-sight-site-theme";
        const expressiveThemes = ["arcane", "parchment", "arena", "phyrexian", "kamigawa-neon"];
        const randomize = document.querySelector("#theme-randomize");

        function updateRandomizeVisibility() {
          let headerPreference = "random";
          let siteTheme = "default";
          try {
            const storedHeaderPreference = window.localStorage.getItem(headerPreferenceKey);
            if (storedHeaderPreference === "random" || headerManaColors.includes(storedHeaderPreference)) {
              headerPreference = storedHeaderPreference;
            }
            siteTheme = window.localStorage.getItem(siteThemeKey) || "default";
          } catch {
            headerPreference = "random";
            siteTheme = "default";
          }
          document.documentElement.dataset.sessionColorMode = expressiveThemes.includes(siteTheme)
            ? "theme"
            : headerPreference === "random"
              ? "random"
              : "fixed";
        }

        function getNextHeaderMana() {
          const currentMana = document.documentElement.dataset.headerMana;
          const options = headerManaColors.filter((color) => color !== currentMana);
          const colors = options.length ? options : headerManaColors;
          return colors[Math.floor(Math.random() * colors.length)];
        }

        randomize?.addEventListener("click", () => {
          const nextHeaderMana = getNextHeaderMana();
          document.documentElement.dataset.headerMana = nextHeaderMana;
          try {
            window.sessionStorage.setItem(storageKey, nextHeaderMana);
            window.localStorage.setItem(headerPreferenceKey, "random");
          } catch {
            // Session theme still applies for the current page if storage is unavailable.
          }
          updateRandomizeVisibility();
        });

        updateRandomizeVisibility();
      })();
    </script>
    <script is:inline>
      (() => {
        const storageKey = "future-sight-theme";
        const toggle = document.querySelector("#theme-toggle");
        const toggleText = toggle?.querySelector(".theme-toggle-text");
        const icon = toggle?.querySelector(".theme-toggle-icon");
        const sunIcon = `
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M11 2h2v4h-2V2Zm0 16h2v4h-2v-4Zm7.66-13.07 1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83ZM6.76 14.83l1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83ZM18 11h4v2h-4v-2ZM2 11h4v2H2v-2Zm14.24 4.83 2.83 2.83-1.41 1.41-2.83-2.83 1.41-1.41ZM5.34 4.93l2.83 2.83-1.41 1.41-2.83-2.83 1.41-1.41ZM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z" fill="currentColor" />
          </svg>
        `;
        const moonIcon = `
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M20.5 15.1A8.5 8.5 0 0 1 8.9 3.5a8 8 0 1 0 11.6 11.6Z" fill="currentColor" />
          </svg>
        `;

        function applyTheme(theme) {
          const isDark = theme === "dark";
          document.documentElement.dataset.theme = isDark ? "dark" : "light";
          toggle?.setAttribute("aria-pressed", String(isDark));
          toggle?.setAttribute("aria-label", `Switch to ${isDark ? "light" : "dark"} mode`);
          if (toggleText) toggleText.textContent = isDark ? "Light" : "Dark";
          if (icon) icon.innerHTML = isDark ? sunIcon : moonIcon;
        }

        if (!toggle) return;

        applyTheme(document.documentElement.dataset.theme || "light");

        toggle.addEventListener("click", () => {
          const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          try {
            window.localStorage.setItem(storageKey, nextTheme);
          } catch {
            // Theme still applies for the current page if preference storage is unavailable.
          }
          applyTheme(nextTheme);
        });
      })();
    </script>
  </body>
</html>
