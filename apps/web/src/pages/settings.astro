---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Settings | Future Sight">
  <section class="settings-shell">
    <div class="page-heading">
      <h1>Settings</h1>
      <a class="button-link action-button muted compact compact-action" href="/">Back</a>
    </div>

    <form id="settings-form" class="settings-form">
      <section class="settings-panel" aria-labelledby="appearance-heading">
        <h2 id="appearance-heading">Appearance</h2>
        <div class="settings-grid">
          <label>
            <span>Site Theme</span>
            <select id="site-theme" name="site-theme">
              <option value="default">Default</option>
              <option value="arcane">Arcane</option>
              <option value="parchment">Parchment</option>
              <option value="arena">Arena</option>
              <option value="phyrexian">Phyrexian</option>
              <option value="kamigawa-neon">Kamigawa Neon</option>
              <option value="high-contrast">High Contrast</option>
            </select>
          </label>

          <label>
            <span>Mode</span>
            <select id="color-mode" name="color-mode">
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </label>

          <label>
            <span>Session Color</span>
            <select id="session-color" name="session-color">
              <option value="random">Random</option>
              <option value="white">White</option>
              <option value="blue">Blue</option>
              <option value="black">Black</option>
              <option value="red">Red</option>
              <option value="green">Green</option>
            </select>
          </label>

          <label>
            <span>Mana Color Palette</span>
            <select id="mana-palette" name="mana-palette">
              <option value="classic">Classic</option>
              <option value="vivid">Vivid</option>
              <option value="soft">Wilds</option>
            </select>
            <span class="mana-palette-preview" aria-label="Mana color palette preview">
              <span class="color-w" title="White"></span>
              <span class="color-u" title="Blue"></span>
              <span class="color-b" title="Black"></span>
              <span class="color-r" title="Red"></span>
              <span class="color-g" title="Green"></span>
              <span class="color-c" title="Colorless"></span>
            </span>
          </label>
        </div>
      </section>

      <section class="settings-panel" aria-labelledby="deck-defaults-heading">
        <h2 id="deck-defaults-heading">Deck Defaults</h2>
        <div class="settings-grid">
          <label>
            <span>Default Deck View</span>
            <select id="default-deck-view" name="default-deck-view">
              <option value="list">List</option>
              <option value="stacks">Stacks</option>
              <option value="gallery">Gallery</option>
            </select>
          </label>

          <label>
            <span>Default Deck Sort</span>
            <select id="default-deck-sort" name="default-deck-sort">
              <option value="updated-desc">Recently edited</option>
              <option value="name-asc">Name A-Z</option>
              <option value="format-asc">Format A-Z</option>
              <option value="colors-asc">Colors</option>
            </select>
          </label>

          <label>
            <span>Default Import Format</span>
            <select id="default-import-format" name="default-import-format">
              <option value="modern">Modern</option>
              <option value="standard">Standard</option>
              <option value="pioneer">Pioneer</option>
              <option value="legacy">Legacy</option>
              <option value="vintage">Vintage</option>
              <option value="pauper">Pauper</option>
            </select>
          </label>
        </div>
      </section>
    </form>
  </section>

  <script>
    const STORAGE_KEYS = {
      siteTheme: "future-sight-site-theme",
      colorMode: "future-sight-theme",
      sessionColor: "future-sight-session-color",
      manaPalette: "future-sight-mana-palette",
      headerMana: "future-sight-header-mana",
      defaultDeckView: "future-sight-default-deck-view",
      defaultDeckSort: "future-sight-default-deck-sort",
      defaultImportFormat: "future-sight-default-import-format",
    };
    const SITE_THEMES = ["default", "arcane", "parchment", "arena", "phyrexian", "kamigawa-neon", "high-contrast"];
    const EXPRESSIVE_THEMES = ["arcane", "parchment", "arena", "phyrexian", "kamigawa-neon"];
    const COLOR_MODES = ["light", "dark"];
    const SESSION_COLORS = ["random", "white", "blue", "black", "red", "green"];
    const MANA_PALETTES = ["classic", "vivid", "soft"];
    const HEADER_COLORS = ["white", "blue", "black", "red", "green"];
    const DECK_VIEWS = ["list", "stacks", "gallery"];
    const DECK_SORTS = ["updated-desc", "name-asc", "format-asc", "colors-asc"];
    const IMPORT_FORMATS = ["modern", "standard", "pioneer", "legacy", "vintage", "pauper"];

    const settingsForm = document.querySelector("#settings-form");
    const siteTheme = document.querySelector("#site-theme");
    const colorMode = document.querySelector("#color-mode");
    const sessionColor = document.querySelector("#session-color");
    const manaPalette = document.querySelector("#mana-palette");
    const defaultDeckView = document.querySelector("#default-deck-view");
    const defaultDeckSort = document.querySelector("#default-deck-sort");
    const defaultImportFormat = document.querySelector("#default-import-format");
    const themeRandomize = document.querySelector("#theme-randomize");
    const themeToggle = document.querySelector("#theme-toggle");
    const themeToggleText = themeToggle?.querySelector(".theme-toggle-text");
    const themeToggleIcon = themeToggle?.querySelector(".theme-toggle-icon");
    const sunIcon = `
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M11 2h2v4h-2V2Zm0 16h2v4h-2v-4Zm7.66-13.07 1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83ZM6.76 14.83l1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83ZM18 11h4v2h-4v-2ZM2 11h4v2H2v-2Zm14.24 4.83 2.83 2.83-1.41 1.41-2.83-2.83 1.41-1.41ZM5.34 4.93l2.83 2.83-1.41 1.41-2.83-2.83 1.41-1.41ZM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z" fill="currentColor" />
      </svg>
    `;
    const moonIcon = `
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M20.5 15.1A8.5 8.5 0 0 1 8.9 3.5a8 8 0 1 0 11.6 11.6Z" fill="currentColor" />
      </svg>
    `;

    function getStoredValue(key, options, fallback) {
      try {
        const value = window.localStorage.getItem(key);
        return options.includes(value) ? value : fallback;
      } catch {
        return fallback;
      }
    }

    function setStoredValue(key, value) {
      try {
        window.localStorage.setItem(key, value);
      } catch {
        // Preferences still apply to the current page when storage is unavailable.
      }
    }

    function randomHeaderColor() {
      return HEADER_COLORS[Math.floor(Math.random() * HEADER_COLORS.length)];
    }

    function applySessionColor(value) {
      const nextHeaderColor = value === "random" ? randomHeaderColor() : value;
      document.documentElement.dataset.headerMana = nextHeaderColor;
      try {
        window.sessionStorage.setItem(STORAGE_KEYS.headerMana, nextHeaderColor);
      } catch {
        // The current page still receives the selected color.
      }
    }

    function isExpressiveTheme(value) {
      return EXPRESSIVE_THEMES.includes(value);
    }

    function syncSessionColorControls() {
      const themeOwnsAccent = isExpressiveTheme(siteTheme.value);
      sessionColor.disabled = themeOwnsAccent;
      document.documentElement.dataset.sessionColorMode = themeOwnsAccent
        ? "theme"
        : sessionColor.value === "random"
          ? "random"
          : "fixed";
    }

    function syncThemeToggle(value) {
      const isDark = value === "dark";
      themeToggle?.setAttribute("aria-pressed", String(isDark));
      themeToggle?.setAttribute("aria-label", `Switch to ${isDark ? "light" : "dark"} mode`);
      if (themeToggleText) themeToggleText.textContent = isDark ? "Light" : "Dark";
      if (themeToggleIcon) themeToggleIcon.innerHTML = isDark ? sunIcon : moonIcon;
    }

    function loadSettings() {
      siteTheme.value = getStoredValue(STORAGE_KEYS.siteTheme, SITE_THEMES, "default");
      colorMode.value = getStoredValue(STORAGE_KEYS.colorMode, COLOR_MODES, document.documentElement.dataset.theme || "light");
      sessionColor.value = getStoredValue(STORAGE_KEYS.sessionColor, SESSION_COLORS, "random");
      manaPalette.value = getStoredValue(STORAGE_KEYS.manaPalette, MANA_PALETTES, "classic");
      document.documentElement.dataset.manaPalette = manaPalette.value;
      defaultDeckView.value = getStoredValue(STORAGE_KEYS.defaultDeckView, DECK_VIEWS, "list");
      defaultDeckSort.value = getStoredValue(STORAGE_KEYS.defaultDeckSort, DECK_SORTS, "updated-desc");
      defaultImportFormat.value = getStoredValue(STORAGE_KEYS.defaultImportFormat, IMPORT_FORMATS, "modern");
      syncSessionColorControls();
    }

    settingsForm.addEventListener("submit", (event) => {
      event.preventDefault();
    });

    siteTheme.addEventListener("change", () => {
      document.documentElement.dataset.siteTheme = siteTheme.value;
      setStoredValue(STORAGE_KEYS.siteTheme, siteTheme.value);
      syncSessionColorControls();
    });

    colorMode.addEventListener("change", () => {
      document.documentElement.dataset.theme = colorMode.value;
      syncThemeToggle(colorMode.value);
      setStoredValue(STORAGE_KEYS.colorMode, colorMode.value);
    });

    sessionColor.addEventListener("change", () => {
      setStoredValue(STORAGE_KEYS.sessionColor, sessionColor.value);
      applySessionColor(sessionColor.value);
      syncSessionColorControls();
    });

    manaPalette.addEventListener("change", () => {
      document.documentElement.dataset.manaPalette = manaPalette.value;
      setStoredValue(STORAGE_KEYS.manaPalette, manaPalette.value);
    });

    defaultDeckView.addEventListener("change", () => {
      setStoredValue(STORAGE_KEYS.defaultDeckView, defaultDeckView.value);
    });

    defaultDeckSort.addEventListener("change", () => {
      setStoredValue(STORAGE_KEYS.defaultDeckSort, defaultDeckSort.value);
    });

    defaultImportFormat.addEventListener("change", () => {
      setStoredValue(STORAGE_KEYS.defaultImportFormat, defaultImportFormat.value);
    });

    themeToggle?.addEventListener("click", () => {
      colorMode.value = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    });

    themeRandomize?.addEventListener("click", () => {
      sessionColor.value = "random";
      syncSessionColorControls();
    });

    loadSettings();
  </script>
</BaseLayout>
