---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Decks | Future Sight">
  <section class="decks-shell">
    <div class="page-heading">
      <h1>Decks</h1>
      <a class="button-link action-button muted compact compact-action" href="/">Back</a>
    </div>

    <section class="deck-browser-controls" aria-label="Browse decks">
      <label class="deck-search-label">
        <input id="deck-search" type="search" autocomplete="off" placeholder="Search decks" aria-label="Search decks" />
      </label>

      <details class="deck-filter-panel">
        <summary>Filters</summary>
        <div class="deck-filter-content">
          <div class="deck-filter-group" role="group" aria-label="Colors">
            <div class="deck-filter-group-heading">
              <div class="deck-filter-mode" aria-label="Color filter mode">
                <label>
                  <input type="radio" name="color-filter-mode" value="and" checked />
                  <span>AND</span>
                </label>
                <label>
                  <input type="radio" name="color-filter-mode" value="or" />
                  <span>OR</span>
                </label>
              </div>
            </div>
            <div class="deck-filter-grid">
              <label class="deck-color-filter color-w"><input type="checkbox" name="color-filter" value="W" /> White</label>
              <label class="deck-color-filter color-u"><input type="checkbox" name="color-filter" value="U" /> Blue</label>
              <label class="deck-color-filter color-b"><input type="checkbox" name="color-filter" value="B" /> Black</label>
              <label class="deck-color-filter color-r"><input type="checkbox" name="color-filter" value="R" /> Red</label>
              <label class="deck-color-filter color-g"><input type="checkbox" name="color-filter" value="G" /> Green</label>
              <label class="deck-color-filter color-c"><input type="checkbox" name="color-filter" value="C" /> Colorless</label>
            </div>
          </div>

          <div class="deck-filter-group" role="group" aria-label="Formats">
            <div class="deck-filter-grid">
              <label><input type="checkbox" name="format-filter" value="modern" /> Modern</label>
              <label><input type="checkbox" name="format-filter" value="standard" /> Standard</label>
              <label><input type="checkbox" name="format-filter" value="pioneer" /> Pioneer</label>
              <label><input type="checkbox" name="format-filter" value="legacy" /> Legacy</label>
              <label><input type="checkbox" name="format-filter" value="vintage" /> Vintage</label>
              <label><input type="checkbox" name="format-filter" value="pauper" /> Pauper</label>
            </div>
          </div>

          <div class="deck-filter-actions">
            <button id="clear-deck-filters" class="action-button muted hollow-button compact-action" type="button">
              Clear
            </button>
          </div>
        </div>
      </details>
      <p id="deck-browser-status" class="empty-state" role="status" aria-live="polite"></p>
    </section>

    <div id="all-decks-list" class="recent-decks-list" aria-live="polite">
      <p class="empty-state">Loading decks...</p>
    </div>
  </section>

  <script>
    import { API_URL, formatDeckFormat, formatShortDateTime, renderColorSquares } from "../../scripts/deck-ui.js";

    const allDecksList = document.querySelector("#all-decks-list");
    const deckSearch = document.querySelector("#deck-search");
    const deckBrowserStatus = document.querySelector("#deck-browser-status");
    const clearDeckFilters = document.querySelector("#clear-deck-filters");
    const colorFilterInputs = Array.from(document.querySelectorAll('input[name="color-filter"]'));
    const formatFilterInputs = Array.from(document.querySelectorAll('input[name="format-filter"]'));
    const colorFilterModeInputs = Array.from(document.querySelectorAll('input[name="color-filter-mode"]'));
    const colorOrder = ["W", "U", "B", "R", "G"];
    let allDecks = [];

    function selectedValues(inputs) {
      return inputs.filter((input) => input.checked).map((input) => input.value);
    }

    function deckColors(deck) {
      const colors = deck.color_identity || [];
      return colors.length ? colors : ["C"];
    }

    function deckMatchesSearch(deck, query) {
      if (!query) return true;
      const searchable = [deck.name, deck.description, deck.format].filter(Boolean).join(" ").toLowerCase();
      return searchable.includes(query);
    }

    function deckMatchesColors(deck, selectedColors, colorMode) {
      if (!selectedColors.length) return true;
      const colors = deckColors(deck);
      if (colorMode === "or") {
        return selectedColors.some((color) => colors.includes(color));
      }
      return selectedColors.every((color) => colors.includes(color));
    }

    function deckMatchesFormats(deck, selectedFormats) {
      if (!selectedFormats.length) return true;
      return selectedFormats.includes(deck.format || "unknown");
    }

    function filteredDecks() {
      const query = deckSearch.value.trim().toLowerCase();
      const selectedColors = selectedValues(colorFilterInputs);
      const selectedFormats = selectedValues(formatFilterInputs);
      const colorMode = colorFilterModeInputs.find((input) => input.checked)?.value || "and";

      return allDecks.filter(
        (deck) =>
          deckMatchesSearch(deck, query) &&
          deckMatchesColors(deck, selectedColors, colorMode) &&
          deckMatchesFormats(deck, selectedFormats),
      );
    }

    function renderBrowserStatus(visibleCount) {
      if (!allDecks.length) {
        deckBrowserStatus.textContent = "";
        return;
      }

      const deckLabel = visibleCount === 1 ? "deck" : "decks";
      deckBrowserStatus.textContent = `${visibleCount} ${deckLabel} shown`;
    }

    function renderFilteredDecks() {
      const decks = filteredDecks();
      renderDecks(decks, allDecks.length > 0);
      renderBrowserStatus(decks.length);
    }

    function renderDeckColorRail(colors) {
      const rail = document.createElement("span");
      rail.className = "deck-list-color-rail";
      rail.setAttribute("aria-hidden", "true");

      const visibleColors = colorOrder.filter((color) => colors?.includes(color));
      const railColors = visibleColors.length ? visibleColors : ["C"];
      railColors.forEach((color) => {
        const segment = document.createElement("span");
        segment.className = `deck-list-color-segment color-${color.toLowerCase()}`;
        rail.append(segment);
      });

      return rail;
    }

    function renderThumbnailCard(deck) {
      const card = deck.thumbnail_card;
      if (!card) return null;

      const data = card.card_data || {};
      const thumbnail = document.createElement("span");
      thumbnail.className = "deck-list-thumbnail";

      if (data.image_uri) {
        const image = document.createElement("img");
        image.src = data.image_uri;
        image.alt = data.name || card.name || deck.thumbnail_card_name || "Deck thumbnail card";
        thumbnail.append(image);
      } else {
        const placeholder = document.createElement("span");
        placeholder.className = "deck-list-thumbnail-empty";
        placeholder.textContent = data.name || card.name || deck.thumbnail_card_name || "Thumbnail";
        thumbnail.append(placeholder);
      }

      return thumbnail;
    }

    function renderDecks(decks, hasLoadedDecks = decks.length > 0) {
      allDecksList.innerHTML = "";

      if (!decks.length) {
        const empty = document.createElement("p");
        empty.className = "empty-state";
        empty.textContent = hasLoadedDecks ? "No decks match these filters." : "No saved decks yet.";
        allDecksList.append(empty);
        return;
      }

      decks.forEach((deck) => {
        const item = document.createElement("article");
        item.className = "recent-deck-link deck-list-item deck-list-item-with-rail";
        item.append(renderDeckColorRail(deck.color_identity || []));

        const link = document.createElement("a");
        link.className = "deck-list-content deck-list-link";
        link.href = `/decks/view?id=${encodeURIComponent(deck.id)}`;

        const deckInfo = document.createElement("span");
        deckInfo.className = "deck-list-info";

        const name = document.createElement("span");
        name.className = "recent-deck-name";
        name.textContent = deck.name || "Untitled Deck";

        const title = document.createElement("span");
        title.className = "deck-list-title";
        title.append(name, renderColorSquares(deck.color_identity || []));

        const updatedAt = document.createElement("span");
        updatedAt.className = "deck-list-updated";
        updatedAt.textContent = `Edited ${formatShortDateTime(deck.updated_at)}`;
        updatedAt.hidden = !deck.updated_at;

        const meta = document.createElement("span");
        meta.className = "recent-deck-meta";
        meta.textContent = formatDeckFormat(deck.format || "unknown");

        const description = document.createElement("span");
        description.className = "recent-deck-description";
        description.textContent = deck.description || "";
        description.hidden = !deck.description;

        deckInfo.append(title, updatedAt, description, meta);

        const thumbnail = renderThumbnailCard(deck);
        if (thumbnail) {
          link.classList.add("deck-list-link-with-thumbnail");
          link.append(thumbnail, deckInfo);
        } else {
          link.append(deckInfo);
        }

        const actions = document.createElement("span");
        actions.className = "deck-list-actions";

        const versionsLink = document.createElement("a");
        versionsLink.className = "action-button version-button hollow-button deck-list-delete compact-action";
        versionsLink.href = `/decks/versions?id=${encodeURIComponent(deck.id)}`;
        versionsLink.textContent = "Versions";

        const deleteButton = document.createElement("button");
        deleteButton.className = "action-button danger-button hollow-button deck-list-delete compact-action";
        deleteButton.type = "button";
        deleteButton.textContent = "Delete";
        deleteButton.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          deleteDeck(deck, item, deleteButton);
        });

        actions.append(versionsLink, deleteButton);
        item.append(link, actions);
        allDecksList.append(item);
      });
    }

    async function deleteDeck(deck, item, deleteButton) {
      const confirmed = window.confirm(`Delete ${deck.name || "this deck"}?`);
      if (!confirmed) return;

      deleteButton.disabled = true;

      try {
        const response = await fetch(`${API_URL}/decks/${deck.id}`, { method: "DELETE" });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not delete deck.");
        }

        allDecks = allDecks.filter((candidate) => candidate.id !== deck.id);
        renderFilteredDecks();
      } catch (error) {
        deckBrowserStatus.textContent = error instanceof Error ? error.message : "Could not delete deck.";
        deleteButton.disabled = false;
      }
    }

    async function loadDecks() {
      try {
        const response = await fetch(`${API_URL}/decks`);
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not load decks.");
        }
        allDecks = Array.isArray(data) ? data : [];
        renderFilteredDecks();
      } catch {
        allDecks = [];
        allDecksList.innerHTML = "";
        const error = document.createElement("p");
        error.className = "empty-state";
        error.textContent = "Decks are unavailable.";
        allDecksList.append(error);
        deckBrowserStatus.textContent = "";
      }
    }

    deckSearch.addEventListener("input", renderFilteredDecks);
    colorFilterInputs.forEach((input) => input.addEventListener("change", renderFilteredDecks));
    formatFilterInputs.forEach((input) => input.addEventListener("change", renderFilteredDecks));
    colorFilterModeInputs.forEach((input) => input.addEventListener("change", renderFilteredDecks));
    clearDeckFilters.addEventListener("click", () => {
      deckSearch.value = "";
      colorFilterInputs.forEach((input) => {
        input.checked = false;
      });
      formatFilterInputs.forEach((input) => {
        input.checked = false;
      });
      colorFilterModeInputs.forEach((input) => {
        input.checked = input.value === "and";
      });
      renderFilteredDecks();
      deckSearch.focus();
    });

    loadDecks();
  </script>
</BaseLayout>
