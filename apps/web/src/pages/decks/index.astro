---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Decks | Future Sight">
  <section class="decks-shell">
    <div class="page-heading">
      <h1>Decks</h1>
      <a class="button-link action-button muted compact compact-action" href="/">Back</a>
    </div>

    <div id="all-decks-list" class="recent-decks-list" aria-live="polite">
      <p class="empty-state">Loading decks...</p>
    </div>
  </section>

  <script>
    import { API_URL, formatDeckFormat, formatShortDateTime, renderColorSquares } from "../../scripts/deck-ui.js";

    const allDecksList = document.querySelector("#all-decks-list");

    function renderThumbnailCard(deck) {
      const card = deck.thumbnail_card;
      if (!card) return null;

      const data = card.card_data || {};
      const thumbnail = document.createElement("span");
      thumbnail.className = "deck-list-thumbnail";

      if (data.image_uri) {
        const image = document.createElement("img");
        image.src = data.image_uri;
        image.alt = data.name || card.name || deck.thumbnail_card_name || "Deck thumbnail card";
        thumbnail.append(image);
      } else {
        const placeholder = document.createElement("span");
        placeholder.className = "deck-list-thumbnail-empty";
        placeholder.textContent = data.name || card.name || deck.thumbnail_card_name || "Thumbnail";
        thumbnail.append(placeholder);
      }

      return thumbnail;
    }

    function renderDecks(decks) {
      allDecksList.innerHTML = "";

      if (!decks.length) {
        const empty = document.createElement("p");
        empty.className = "empty-state";
        empty.textContent = "No saved decks yet.";
        allDecksList.append(empty);
        return;
      }

      decks.forEach((deck) => {
        const item = document.createElement("article");
        item.className = "recent-deck-link deck-list-item";

        const link = document.createElement("a");
        link.className = "deck-list-content deck-list-link";
        link.href = `/decks/view?id=${encodeURIComponent(deck.id)}`;

        const deckInfo = document.createElement("span");
        deckInfo.className = "deck-list-info";

        const name = document.createElement("span");
        name.className = "recent-deck-name";
        name.textContent = deck.name || "Untitled Deck";

        const updatedAt = document.createElement("span");
        updatedAt.className = "deck-list-updated";
        updatedAt.textContent = `Edited ${formatShortDateTime(deck.updated_at)}`;
        updatedAt.hidden = !deck.updated_at;

        const meta = document.createElement("span");
        meta.className = "recent-deck-meta";
        meta.append(
          renderColorSquares(deck.color_identity || []),
          document.createTextNode(formatDeckFormat(deck.format || "unknown")),
        );

        const description = document.createElement("span");
        description.className = "recent-deck-description";
        description.textContent = deck.description || "";
        description.hidden = !deck.description;

        deckInfo.append(name, updatedAt, description, meta);

        const thumbnail = renderThumbnailCard(deck);
        if (thumbnail) {
          link.classList.add("deck-list-link-with-thumbnail");
          link.append(thumbnail, deckInfo);
        } else {
          link.append(deckInfo);
        }

        const actions = document.createElement("span");
        actions.className = "deck-list-actions";

        const versionsLink = document.createElement("a");
        versionsLink.className = "action-button version-button hollow-button deck-list-delete compact-action";
        versionsLink.href = `/decks/versions?id=${encodeURIComponent(deck.id)}`;
        versionsLink.textContent = "Versions";

        const deleteButton = document.createElement("button");
        deleteButton.className = "action-button danger-button hollow-button deck-list-delete compact-action";
        deleteButton.type = "button";
        deleteButton.textContent = "Delete";
        deleteButton.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          deleteDeck(deck, item, deleteButton);
        });

        actions.append(versionsLink, deleteButton);
        item.append(link, actions);
        allDecksList.append(item);
      });
    }

    async function deleteDeck(deck, item, deleteButton) {
      const confirmed = window.confirm(`Delete ${deck.name || "this deck"}?`);
      if (!confirmed) return;

      deleteButton.disabled = true;

      try {
        const response = await fetch(`${API_URL}/decks/${deck.id}`, { method: "DELETE" });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not delete deck.");
        }

        item.remove();
        if (!allDecksList.children.length) {
          const empty = document.createElement("p");
          empty.className = "empty-state";
          empty.textContent = "No saved decks yet.";
          allDecksList.append(empty);
        }
      } catch {
        deleteButton.disabled = false;
      }
    }

    async function loadDecks() {
      try {
        const response = await fetch(`${API_URL}/decks`);
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not load decks.");
        }
        renderDecks(Array.isArray(data) ? data : []);
      } catch {
        allDecksList.innerHTML = "";
        const error = document.createElement("p");
        error.className = "empty-state";
        error.textContent = "Decks are unavailable.";
        allDecksList.append(error);
      }
    }

    loadDecks();
  </script>
</BaseLayout>
