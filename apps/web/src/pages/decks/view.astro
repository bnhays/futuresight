---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Deck Detail | Future Sight">
  <section class="deck-view-shell">
    <div class="deck-view-header">
      <div>
        <h1 id="deck-title">Deck Detail</h1>
        <p id="deck-description" class="deck-detail-description" hidden></p>
        <p id="deck-meta">Loading deck...</p>
      </div>
      <div class="deck-actions">
        <a id="back-link" class="button-link action-button muted compact compact-action" href="/">Back</a>
        <button id="edit-deck" class="action-button success-button hollow-button compact-action" type="button">Edit</button>
        <a id="versions-deck" class="action-button version-button hollow-button compact-action" href="/decks">Versions</a>
        <button id="restore-version" class="action-button primary-button hollow-button compact-action" type="button" hidden>
          Restore as Latest
        </button>
        <button id="delete-deck" class="action-button danger-button hollow-button compact-action" type="button">Delete</button>
      </div>
    </div>

    <section id="deck-edit-panel" class="deck-edit-panel" hidden>
      <form id="deck-edit-form" class="import-form deck-edit-form">
        <div class="import-fields">
          <label>
            <span>Deck Name</span>
            <input id="edit-deck-name" name="name" type="text" autocomplete="off" />
          </label>

          <label>
            <span>Format</span>
            <select id="edit-deck-format" name="format">
              <option value="modern">Modern</option>
              <option value="standard">Standard</option>
              <option value="pioneer">Pioneer</option>
              <option value="legacy">Legacy</option>
              <option value="vintage">Vintage</option>
              <option value="pauper">Pauper</option>
              <option value="commander">Commander</option>
            </select>
          </label>
        </div>

        <label>
          <span>Description</span>
          <input id="edit-deck-description" name="description" type="text" maxlength="150" autocomplete="off" />
        </label>

        <label>
          <span>Thumbnail Card</span>
          <input id="edit-thumbnail-card-name" name="thumbnail_card_name" type="text" autocomplete="off" />
        </label>

        <label for="edit-decklist">Decklist</label>
        <textarea id="edit-decklist" name="decklist" rows="18" spellcheck="false"></textarea>

        <div class="form-actions">
          <div class="deck-actions">
            <button id="save-deck" class="action-button primary-button hollow-button" type="submit">Save</button>
            <button id="cancel-edit" class="action-button muted hollow-button" type="button">Back</button>
          </div>
          <span id="edit-status" role="status" aria-live="polite"></span>
        </div>
      </form>
    </section>

    <section id="deck-panel" class="deck-panel" hidden>
      <div id="deck-sections" class="deck-sections"></div>
    </section>

    <aside id="inspect-panel" class="inspect-panel" hidden>
      <button id="close-inspect" class="icon-button" type="button" aria-label="Close card inspection">x</button>
      <div id="inspect-content"></div>
    </aside>

    <div id="unsaved-quantity-bar" class="unsaved-quantity-bar" role="status" aria-live="polite" hidden>
      <span>You have unsaved changes</span>
      <div class="deck-actions">
        <button id="save-quantity-changes" class="action-button primary-button hollow-button" type="button">Save</button>
        <button id="discard-quantity-changes" class="action-button muted hollow-button" type="button">
          Discard changes
        </button>
      </div>
    </div>
  </section>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
    const COLOR_ORDER = ["W", "U", "B", "R", "G", "C"];
    const LAND_COLOR_ORDER = ["W", "U", "B", "R", "G"];
    const MAINBOARD_TYPE_ORDER = ["Creature", "Planeswalker", "Artifact", "Enchantment", "Instant", "Sorcery", "Land"];
    const COLOR_LABELS = {
      W: "White",
      U: "Blue",
      B: "Black",
      R: "Red",
      G: "Green",
      C: "Colorless",
    };

    const deckViewShell = document.querySelector(".deck-view-shell");
    const searchParams = new URLSearchParams(window.location.search);
    const deckId = searchParams.get("id");
    const selectedVersionId = searchParams.get("version_id");
    const backLink = document.querySelector("#back-link");
    const deckTitle = document.querySelector("#deck-title");
    const deckDescription = document.querySelector("#deck-description");
    const deckMeta = document.querySelector("#deck-meta");
    const deckPanel = document.querySelector("#deck-panel");
    const deckSections = document.querySelector("#deck-sections");
    const inspectPanel = document.querySelector("#inspect-panel");
    const inspectContent = document.querySelector("#inspect-content");
    const closeInspect = document.querySelector("#close-inspect");
    const editDeckButton = document.querySelector("#edit-deck");
    const versionsDeckButton = document.querySelector("#versions-deck");
    const restoreVersionButton = document.querySelector("#restore-version");
    const deleteDeckButton = document.querySelector("#delete-deck");
    const deckEditPanel = document.querySelector("#deck-edit-panel");
    const deckEditForm = document.querySelector("#deck-edit-form");
    const editDeckName = document.querySelector("#edit-deck-name");
    const editDeckFormat = document.querySelector("#edit-deck-format");
    const editDeckDescription = document.querySelector("#edit-deck-description");
    const editThumbnailCardName = document.querySelector("#edit-thumbnail-card-name");
    const editDecklist = document.querySelector("#edit-decklist");
    const saveDeckButton = document.querySelector("#save-deck");
    const cancelEditButton = document.querySelector("#cancel-edit");
    const editStatus = document.querySelector("#edit-status");
    const unsavedQuantityBar = document.querySelector("#unsaved-quantity-bar");
    const saveQuantityChangesButton = document.querySelector("#save-quantity-changes");
    const discardQuantityChangesButton = document.querySelector("#discard-quantity-changes");
    let currentDeck = null;
    let initialDeck = null;
    let inspectedCardKey = null;
    let matchupHistoryShowingAll = false;
    let activeMatchupId = null;
    let libraryDecks = null;

    function formatDateTime(value) {
      if (!value) return "";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "";
      return date.toLocaleString(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
        hour: "numeric",
        minute: "2-digit",
      });
    }

    function versionLabel(version) {
      return version.version_name ? `v${version.version_number} - ${version.version_name}` : `v${version.version_number}`;
    }

    function isPreviewMode(deck = currentDeck) {
      return Boolean(selectedVersionId || (deck?.selected_version_id && deck?.active_version_id && deck.selected_version_id !== deck.active_version_id));
    }

    function groupBySection(cards) {
      return cards.reduce((groups, card) => {
        const section = card.section || "mainboard";
        groups[section] = groups[section] || [];
        groups[section].push(card);
        return groups;
      }, {});
    }

    function sectionLabel(section) {
      if (section === "sideboard") return "Sideboard";
      return "Mainboard";
    }

    function typeSectionLabel(type) {
      const labels = {
        Creature: "Creatures",
        Planeswalker: "Planeswalkers",
        Artifact: "Artifacts",
        Enchantment: "Enchantments",
        Instant: "Instants",
        Sorcery: "Sorceries",
        Land: "Lands",
      };
      return labels[type] || type || "Other";
    }

    function formatFormat(format) {
      if (!format) return "";
      return format.charAt(0).toUpperCase() + format.slice(1);
    }

    function getIdentityColors(cards) {
      const colors = new Set();
      cards.forEach((card) => {
        const identity = card.card_data?.color_identity || [];
        identity.forEach((color) => colors.add(color));
      });
      return COLOR_ORDER.filter((color) => colors.has(color));
    }

    function renderColorSquares(colors) {
      const wrapper = document.createElement("span");
      wrapper.className = "color-squares";

      COLOR_ORDER.filter((color) => colors?.includes(color)).forEach((color) => {
        const square = document.createElement("span");
        square.className = `color-square color-${color.toLowerCase()}`;
        square.title = COLOR_LABELS[color] || color;
        wrapper.append(square);
      });

      return wrapper;
    }

    function renderTitle(deck) {
      deckTitle.textContent = "";
      const colors = renderColorSquares(getIdentityColors(deck.cards || []));
      const titleText = document.createElement("span");
      titleText.textContent = deck.name || "Untitled Deck";

      if (colors.children.length) {
        deckTitle.append(colors);
      }
      deckTitle.append(titleText);
      deckDescription.textContent = deck.description || "";
      deckDescription.hidden = !deck.description;
      const versionText = deck.version_number ? ` | ${versionLabel(deck)}` : "";
      deckMeta.textContent = `Format: ${formatFormat(deck.format || "modern")}${versionText}`;
    }

    function applyDeckMode(deck) {
      const previewMode = isPreviewMode(deck);
      backLink.href = previewMode && deckId ? `/decks/versions?id=${encodeURIComponent(deckId)}` : "/";
      backLink.textContent = previewMode ? "Versions" : "Back";
      versionsDeckButton.href = deckId ? `/decks/versions?id=${encodeURIComponent(deckId)}` : "/decks";
      editDeckButton.hidden = previewMode;
      deleteDeckButton.hidden = previewMode;
      versionsDeckButton.hidden = previewMode;
      restoreVersionButton.hidden = !previewMode || deck.selected_version_id === deck.active_version_id;
      if (previewMode) {
        closeEditPanel();
      }
      updateUnsavedQuantityBar();
    }

    function deckToText(cards) {
      const groups = groupBySection(cards || []);
      const lines = [];

      (groups.mainboard || []).forEach((card) => {
        lines.push(`${card.quantity} ${card.name}`);
      });

      if ((groups.sideboard || []).length) {
        if (lines.length) lines.push("");
        lines.push("Sideboard");
        groups.sideboard.forEach((card) => {
          lines.push(`${card.quantity} ${card.name}`);
        });
      }

      return lines.join("\n");
    }

    function cloneDeck(deck) {
      return JSON.parse(JSON.stringify(deck));
    }

    function normalizeText(value) {
      return String(value || "").trim();
    }

    function currentDecklistText() {
      if (!currentDeck) return "";
      return currentDeck.raw_decklist || deckToText(currentDeck.cards || []);
    }

    function hasEditChanges(decklist) {
      if (!currentDeck) return false;
      return (
        normalizeText(editDeckName.value) !== normalizeText(currentDeck.name) ||
        normalizeText(editDeckFormat.value) !== normalizeText(currentDeck.format || "modern") ||
        normalizeText(editDeckDescription.value) !== normalizeText(currentDeck.description) ||
        normalizeText(editThumbnailCardName.value) !== normalizeText(currentDeck.thumbnail_card_name) ||
        normalizeText(decklist) !== normalizeText(currentDecklistText())
      );
    }

    function hasUnsavedQuantityChanges() {
      if (!currentDeck || !initialDeck) return false;
      return deckToText(currentDeck.cards || []) !== deckToText(initialDeck.cards || []);
    }

    function updateUnsavedQuantityBar() {
      unsavedQuantityBar.hidden = isPreviewMode() || !hasUnsavedQuantityChanges();
    }

    function openEditPanel() {
      if (!currentDeck || isPreviewMode()) return;
      editDeckName.value = currentDeck.name || "";
      editDeckFormat.value = currentDeck.format || "modern";
      editDeckDescription.value = currentDeck.description || "";
      editThumbnailCardName.value = currentDeck.thumbnail_card_name || "";
      editDecklist.value = hasUnsavedQuantityChanges()
        ? deckToText(currentDeck.cards || [])
        : currentDecklistText();
      editStatus.textContent = "";
      deckEditPanel.hidden = false;
      closeInspectPanel();
      editDeckName.focus();
    }

    function closeEditPanel() {
      deckEditPanel.hidden = true;
      editStatus.textContent = "";
      deckEditForm.reset();
    }

    function toggleEditPanel() {
      if (deckEditPanel.hidden) {
        openEditPanel();
      } else {
        closeEditPanel();
      }
    }

    function renderWarnings(warnings) {
      const activeWarnings = warnings.filter((warning) => String(warning || "").trim());
      document.querySelectorAll(".message-panel").forEach((panel) => panel.remove());
      if (!activeWarnings.length) return;

      const warningsPanel = document.createElement("section");
      warningsPanel.className = "message-panel";

      const heading = document.createElement("h2");
      heading.textContent = "Warnings";
      warningsPanel.append(heading);

      const warningsList = document.createElement("ul");

      activeWarnings.forEach((warning) => {
        const item = document.createElement("li");
        item.textContent = warning;
        warningsList.append(item);
      });

      warningsPanel.append(warningsList);
      deckViewShell.insertBefore(warningsPanel, deckPanel);
    }

    function manaSymbolClass(value) {
      const normalized = String(value || "")
        .trim()
        .toLowerCase()
        .replace(/\//g, "");

      const aliases = {
        "∞": "infinity",
        "½": "half",
      };

      return aliases[normalized] || normalized;
    }

    function manaColorClass(value) {
      const normalized = String(value || "").trim().toLowerCase();
      const colorClasses = {
        w: "white",
        u: "blue",
        b: "black",
        r: "red",
        g: "green",
        c: "colorless",
        s: "snow",
      };

      return colorClasses[normalized] || "generic";
    }

    function renderSpecialManaSymbol(value) {
      const normalized = String(value || "").trim();
      const upperValue = normalized.toUpperCase();
      const symbolEl = document.createElement("span");
      symbolEl.className = "mana-symbol mana-symbol-custom";
      symbolEl.setAttribute("role", "img");
      symbolEl.setAttribute("aria-label", normalized);
      symbolEl.title = normalized;

      if (upperValue === "S") {
        symbolEl.classList.add("mana-symbol-snow");
        const snowIcon = document.createElement("i");
        snowIcon.className = "mana-symbol-mark ms ms-s";
        symbolEl.append(snowIcon);
        return symbolEl;
      }

      const parts = normalized.split("/");
      const isPhyrexian = parts.at(-1)?.toUpperCase() === "P";

      if (isPhyrexian && parts.length === 2) {
        const colorClass = manaColorClass(parts[0]);
        symbolEl.classList.add(
          "mana-symbol-phyrexian",
          "mana-symbol-solid",
          `mana-solid-${colorClass}`,
        );

        const phyrexianIcon = document.createElement("i");
        phyrexianIcon.className = "mana-symbol-mark mana-symbol-phyrexian-mark ms ms-p";
        symbolEl.append(phyrexianIcon);
        return symbolEl;
      }

      if (isPhyrexian && parts.length === 3) {
        const leftClass = manaColorClass(parts[0]);
        const rightClass = manaColorClass(parts[1]);
        symbolEl.classList.add(
          "mana-symbol-phyrexian",
          "mana-symbol-phyrexian-dual",
          `mana-split-left-${leftClass}`,
          `mana-split-right-${rightClass}`,
        );

        const phyrexianIcon = document.createElement("i");
        phyrexianIcon.className = "mana-symbol-mark mana-symbol-phyrexian-mark ms ms-p";
        symbolEl.append(phyrexianIcon);
        return symbolEl;
      }

      if (parts.length !== 2) return null;

      const [left, right] = parts;
      const leftClass = manaColorClass(left);
      const rightClass = manaColorClass(right);
      symbolEl.classList.add(
        "mana-symbol-hybrid",
        `mana-split-left-${leftClass}`,
        `mana-split-right-${rightClass}`,
      );

      const leftMark = document.createElement("span");
      leftMark.className = "mana-symbol-half mana-symbol-half-left";
      if (/^\d+$/.test(left)) {
        leftMark.textContent = left;
      } else {
        const leftIcon = document.createElement("i");
        leftIcon.className = `mana-symbol-mark ms ms-${manaSymbolClass(left)}`;
        leftMark.append(leftIcon);
      }

      const rightMark = document.createElement("span");
      rightMark.className = "mana-symbol-half mana-symbol-half-right";
      if (/^\d+$/.test(right)) {
        rightMark.textContent = right;
      } else {
        const rightIcon = document.createElement("i");
        rightIcon.className = `mana-symbol-mark ms ms-${manaSymbolClass(right)}`;
        rightMark.append(rightIcon);
      }

      symbolEl.append(leftMark, rightMark);
      return symbolEl;
    }

    function renderManaCost(manaCost) {
      const wrapper = document.createElement("span");
      wrapper.className = "mana-cost";
      const symbols = String(manaCost || "").match(/\{[^}]+\}/g) || [];

      if (!symbols.length && manaCost) {
        wrapper.textContent = manaCost;
        return wrapper;
      }

      symbols.forEach((symbol) => {
        const value = symbol.replace(/[{}]/g, "");
        const specialSymbol = renderSpecialManaSymbol(value);
        if (specialSymbol) {
          wrapper.append(specialSymbol);
          return;
        }

        const symbolEl = document.createElement("i");
        symbolEl.className = `mana-symbol ms ms-cost ms-${manaSymbolClass(value)}`;
        symbolEl.setAttribute("role", "img");
        symbolEl.setAttribute("aria-label", value);
        symbolEl.title = value;
        wrapper.append(symbolEl);
      });

      return wrapper;
    }

    function getListType(typeLine) {
      const cardTypes = String(typeLine || "").split("-")[0] || "";
      const priorities = ["Creature", "Land", "Planeswalker", "Artifact", "Enchantment", "Instant", "Sorcery"];
      return priorities.find((type) => new RegExp(`\\b${type}\\b`, "i").test(cardTypes)) || typeLine || "";
    }

    function groupMainboardByType(cards) {
      const groups = cards.reduce((typeGroups, card) => {
        const type = getListType(card.card_data?.type_line || "") || "Other";
        typeGroups[type] = typeGroups[type] || [];
        typeGroups[type].push(card);
        return typeGroups;
      }, {});

      const orderedTypes = [
        ...MAINBOARD_TYPE_ORDER.filter((type) => groups[type]?.length),
        ...Object.keys(groups)
          .filter((type) => !MAINBOARD_TYPE_ORDER.includes(type))
          .sort((first, second) => first.localeCompare(second)),
      ];

      return orderedTypes.map((type) => [type, groups[type]]);
    }

    function getManaCurveBucket(card) {
      const type = getListType(card.card_data?.type_line || "");
      if (type === "Land") return null;

      const manaValue = Number(card.card_data?.cmc ?? 0);
      if (!Number.isFinite(manaValue)) return 0;
      return Math.min(Math.max(0, Math.floor(manaValue)), 7);
    }

    function getManaCurve(cards) {
      const buckets = Array.from({ length: 8 }, (_, manaValue) => ({
        manaValue,
        label: manaValue === 7 ? "7+" : String(manaValue),
        count: 0,
      }));

      (cards || []).forEach((card) => {
        if ((card.section || "mainboard") !== "mainboard") return;
        const bucket = getManaCurveBucket(card);
        if (bucket === null) return;
        buckets[bucket].count += Number(card.quantity || 0);
      });

      return buckets;
    }

    function renderManaCurve(cards) {
      const curve = getManaCurve(cards);
      const maxCount = Math.max(1, ...curve.map((bucket) => bucket.count));

      const panel = document.createElement("section");
      panel.className = "mana-curve-panel";
      panel.setAttribute("aria-labelledby", "mana-curve-heading");

      const heading = document.createElement("h2");
      heading.id = "mana-curve-heading";
      heading.textContent = "Mana Curve";
      panel.append(heading);

      const bars = document.createElement("div");
      bars.className = "mana-curve-bars";

      curve.forEach((bucket) => {
        const bar = document.createElement("div");
        bar.className = "mana-curve-bar";

        const count = document.createElement("span");
        count.className = "mana-curve-count";
        count.textContent = String(bucket.count);

        const fill = document.createElement("span");
        fill.className = "mana-curve-fill";
        fill.style.height = `${Math.max(0.12, bucket.count / maxCount) * 100}%`;

        const label = document.createElement("span");
        label.className = "mana-curve-label";
        label.textContent = bucket.label;

        bar.append(count, fill, label);
        bars.append(bar);
      });

      panel.append(bars);
      return panel;
    }

    function getProducedManaColors(card) {
      const data = card.card_data || {};
      const producedMana = Array.isArray(data.produced_mana) ? data.produced_mana : [];
      const fallbackColors = Array.isArray(data.color_identity) ? data.color_identity : [];
      const colors = producedMana.length ? producedMana : fallbackColors;
      return LAND_COLOR_ORDER.filter((color) => colors.includes(color));
    }

    function getLandColorProduction(cards) {
      const production = LAND_COLOR_ORDER.map((color) => ({
        color,
        label: COLOR_LABELS[color] || color,
        count: 0,
        percentage: 0,
      }));
      const productionByColor = Object.fromEntries(production.map((item) => [item.color, item]));
      let landCount = 0;

      (cards || []).forEach((card) => {
        if ((card.section || "mainboard") !== "mainboard") return;
        if (getListType(card.card_data?.type_line || "") !== "Land") return;

        const quantity = Number(card.quantity || 0);
        if (!Number.isFinite(quantity) || quantity <= 0) return;

        landCount += quantity;
        getProducedManaColors(card).forEach((color) => {
          productionByColor[color].count += quantity;
        });
      });

      production.forEach((item) => {
        item.percentage = landCount ? Math.round((item.count / landCount) * 100) : 0;
      });

      return production;
    }

    function renderLandColorProduction(cards) {
      const production = getLandColorProduction(cards);

      const panel = document.createElement("section");
      panel.className = "land-colors-panel";
      panel.setAttribute("aria-labelledby", "land-colors-heading");

      const heading = document.createElement("h2");
      heading.id = "land-colors-heading";
      heading.textContent = "Land Colors";
      panel.append(heading);

      const bars = document.createElement("div");
      bars.className = "land-color-bars";

      production.forEach((item) => {
        const row = document.createElement("div");
        row.className = "land-color-row";

        const label = document.createElement("span");
        label.className = "land-color-label";
        label.textContent = item.label;

        const track = document.createElement("span");
        track.className = "land-color-track";
        track.setAttribute("aria-label", `${item.label}: ${item.percentage}% of lands`);

        const fill = document.createElement("span");
        fill.className = `land-color-fill color-${item.color.toLowerCase()}`;
        fill.style.width = `${item.percentage}%`;
        track.append(fill);

        const value = document.createElement("span");
        value.className = "land-color-value";
        value.textContent = `${item.percentage}%`;

        row.append(label, track, value);
        bars.append(row);
      });

      panel.append(bars);
      return panel;
    }

    function currentVersionId() {
      return currentDeck?.selected_version_id || currentDeck?.active_version_id || "";
    }

    function matchupDate(value) {
      if (!value) return "";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "";
      return date.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
      });
    }

    function renderMatchupCard(matchup) {
      const card = document.createElement("article");
      card.className = "matchup-card";
      if (matchup.id === activeMatchupId) {
        card.classList.add("matchup-card-active");
      }
      card.tabIndex = 0;
      card.setAttribute("role", "button");
      card.setAttribute("aria-label", `Edit matchup against ${matchup.opponent_deck || "Unknown Deck"}`);
      card.addEventListener("click", () => openMatchupEditor(matchup.id));
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openMatchupEditor(matchup.id);
        }
      });

      const opponent = document.createElement("h3");
      opponent.textContent = matchup.opponent_deck || "Unknown Deck";

      const tournament = document.createElement("p");
      tournament.className = "matchup-tournament";
      tournament.textContent = matchup.tournament_name || "Unknown Tournament";

      const meta = document.createElement("p");
      meta.className = "matchup-meta";

      const outcome = document.createElement("span");
      outcome.className = "matchup-outcome";
      outcome.textContent = matchup.outcome || "";

      const playedAt = document.createElement("span");
      playedAt.textContent = matchupDate(matchup.created_at);
      playedAt.hidden = !playedAt.textContent;

      meta.append(outcome, playedAt);
      card.append(opponent, tournament, meta);
      return card;
    }

    async function loadLibraryDecks() {
      if (libraryDecks) return libraryDecks;

      const response = await fetch(`${API_URL}/decks`);
      const decks = await response.json();
      if (!response.ok) {
        throw new Error(decks.detail || "Could not load deck library.");
      }

      libraryDecks = Array.isArray(decks) ? decks : [];
      return libraryDecks;
    }

    function selectedMatchup() {
      return (currentDeck?.matchups || []).find((matchup) => matchup.id === activeMatchupId) || null;
    }

    function openMatchupEditor(matchupId) {
      activeMatchupId = activeMatchupId === matchupId ? null : matchupId;
      renderDeck(currentDeck.cards || []);
    }

    async function saveEditedMatchup(event, form, status, submitButton) {
      event.preventDefault();
      if (!deckId || !currentVersionId() || !activeMatchupId) return;

      const formData = new FormData(form);
      const selectedDeckId = String(formData.get("opponent_deck_id") || "").trim();
      const selectedDeck = (libraryDecks || []).find((deck) => deck.id === selectedDeckId);
      const opponentDeck = selectedDeck?.name || String(formData.get("opponent_deck") || "").trim();
      const payload = {
        opponent_deck: opponentDeck,
        opponent_deck_id: selectedDeckId || null,
        tournament_name: String(formData.get("tournament_name") || "").trim(),
        outcome: String(formData.get("outcome") || "").trim(),
      };

      if (!payload.opponent_deck || !payload.tournament_name || !payload.outcome) {
        status.textContent = "Fill out all matchup fields.";
        return;
      }

      submitButton.disabled = true;
      status.textContent = "Saving...";

      try {
        const response = await fetch(
          `${API_URL}/decks/${deckId}/versions/${currentVersionId()}/matchups/${activeMatchupId}`,
          {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          },
        );
        const matchup = await response.json();
        if (!response.ok) {
          throw new Error(matchup.detail || "Could not update matchup.");
        }

        currentDeck.matchups = (currentDeck.matchups || []).map((item) => (
          item.id === matchup.id ? matchup : item
        ));
        initialDeck = cloneDeck(currentDeck);
        activeMatchupId = null;
        renderDeck(currentDeck.cards || []);
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Could not update matchup.";
        submitButton.disabled = false;
      }
    }

    async function deleteMatchup(status, deleteButton) {
      if (!deckId || !currentVersionId() || !activeMatchupId) return;
      const confirmed = window.confirm("Delete this matchup?");
      if (!confirmed) return;

      deleteButton.disabled = true;
      status.textContent = "Deleting...";

      try {
        const response = await fetch(
          `${API_URL}/decks/${deckId}/versions/${currentVersionId()}/matchups/${activeMatchupId}`,
          { method: "DELETE" },
        );
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not delete matchup.");
        }

        currentDeck.matchups = (currentDeck.matchups || []).filter((matchup) => matchup.id !== activeMatchupId);
        initialDeck = cloneDeck(currentDeck);
        activeMatchupId = null;
        renderDeck(currentDeck.cards || []);
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Could not delete matchup.";
        deleteButton.disabled = false;
      }
    }

