---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Deck Detail | Future Sight">
  <section class="deck-view-shell">
    <div class="deck-view-header">
      <div>
        <h1 id="deck-title">Deck Detail</h1>
        <p id="deck-description" class="deck-detail-description" hidden></p>
        <p id="deck-meta">Loading deck...</p>
      </div>
      <div class="deck-actions">
        <a class="button-link action-button muted" href="/">Back</a>
        <button id="edit-deck" class="action-button success-button hollow-button" type="button">Edit</button>
        <button id="delete-deck" class="action-button danger-button hollow-button" type="button">Delete</button>
      </div>
    </div>

    <section id="deck-edit-panel" class="deck-edit-panel" hidden>
      <form id="deck-edit-form" class="import-form deck-edit-form">
        <div class="import-fields">
          <label>
            <span>Deck Name</span>
            <input id="edit-deck-name" name="name" type="text" autocomplete="off" />
          </label>

          <label>
            <span>Format</span>
            <select id="edit-deck-format" name="format">
              <option value="modern">Modern</option>
              <option value="standard">Standard</option>
              <option value="pioneer">Pioneer</option>
              <option value="legacy">Legacy</option>
              <option value="vintage">Vintage</option>
              <option value="pauper">Pauper</option>
              <option value="commander">Commander</option>
            </select>
          </label>
        </div>

        <label>
          <span>Description</span>
          <input id="edit-deck-description" name="description" type="text" maxlength="150" autocomplete="off" />
        </label>

        <label for="edit-decklist">Decklist</label>
        <textarea id="edit-decklist" name="decklist" rows="18" spellcheck="false"></textarea>

        <div class="form-actions">
          <div class="deck-actions">
            <button id="save-deck" class="action-button primary-button hollow-button" type="submit">Save</button>
            <button id="cancel-edit" class="action-button muted hollow-button" type="button">Back</button>
          </div>
          <span id="edit-status" role="status" aria-live="polite"></span>
        </div>
      </form>
    </section>

    <section id="deck-panel" class="deck-panel" hidden>
      <div id="deck-sections" class="deck-sections"></div>
    </section>

    <aside id="inspect-panel" class="inspect-panel" hidden>
      <button id="close-inspect" class="icon-button" type="button" aria-label="Close card inspection">x</button>
      <div id="inspect-content"></div>
    </aside>
  </section>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
    const COLOR_ORDER = ["W", "U", "B", "R", "G", "C"];
    const COLOR_LABELS = {
      W: "White",
      U: "Blue",
      B: "Black",
      R: "Red",
      G: "Green",
      C: "Colorless",
    };

    const deckViewShell = document.querySelector(".deck-view-shell");
    const deckId = new URLSearchParams(window.location.search).get("id");
    const deckTitle = document.querySelector("#deck-title");
    const deckDescription = document.querySelector("#deck-description");
    const deckMeta = document.querySelector("#deck-meta");
    const deckPanel = document.querySelector("#deck-panel");
    const deckSections = document.querySelector("#deck-sections");
    const inspectPanel = document.querySelector("#inspect-panel");
    const inspectContent = document.querySelector("#inspect-content");
    const closeInspect = document.querySelector("#close-inspect");
    const editDeckButton = document.querySelector("#edit-deck");
    const deleteDeckButton = document.querySelector("#delete-deck");
    const deckEditPanel = document.querySelector("#deck-edit-panel");
    const deckEditForm = document.querySelector("#deck-edit-form");
    const editDeckName = document.querySelector("#edit-deck-name");
    const editDeckFormat = document.querySelector("#edit-deck-format");
    const editDeckDescription = document.querySelector("#edit-deck-description");
    const editDecklist = document.querySelector("#edit-decklist");
    const saveDeckButton = document.querySelector("#save-deck");
    const cancelEditButton = document.querySelector("#cancel-edit");
    const editStatus = document.querySelector("#edit-status");
    let currentDeck = null;
    let inspectedCardKey = null;

    function groupBySection(cards) {
      return cards.reduce((groups, card) => {
        const section = card.section || "mainboard";
        groups[section] = groups[section] || [];
        groups[section].push(card);
        return groups;
      }, {});
    }

    function sectionLabel(section) {
      if (section === "sideboard") return "Sideboard";
      return "Mainboard";
    }

    function formatFormat(format) {
      if (!format) return "";
      return format.charAt(0).toUpperCase() + format.slice(1);
    }

    function getIdentityColors(cards) {
      const colors = new Set();
      cards.forEach((card) => {
        const identity = card.card_data?.color_identity || [];
        identity.forEach((color) => colors.add(color));
      });
      return COLOR_ORDER.filter((color) => colors.has(color));
    }

    function renderColorSquares(colors) {
      const wrapper = document.createElement("span");
      wrapper.className = "color-squares";

      COLOR_ORDER.filter((color) => colors?.includes(color)).forEach((color) => {
        const square = document.createElement("span");
        square.className = `color-square color-${color.toLowerCase()}`;
        square.title = COLOR_LABELS[color] || color;
        wrapper.append(square);
      });

      return wrapper;
    }

    function renderTitle(deck) {
      deckTitle.textContent = "";
      const colors = renderColorSquares(getIdentityColors(deck.cards || []));
      const titleText = document.createElement("span");
      titleText.textContent = deck.name || "Untitled Deck";

      if (colors.children.length) {
        deckTitle.append(colors);
      }
      deckTitle.append(titleText);
      deckDescription.textContent = deck.description || "";
      deckDescription.hidden = !deck.description;
      deckMeta.textContent = `Format: ${formatFormat(deck.format || "modern")}`;
    }

    function deckToText(cards) {
      const groups = groupBySection(cards || []);
      const lines = [];

      (groups.mainboard || []).forEach((card) => {
        lines.push(`${card.quantity} ${card.name}`);
      });

      if ((groups.sideboard || []).length) {
        if (lines.length) lines.push("");
        lines.push("Sideboard");
        groups.sideboard.forEach((card) => {
          lines.push(`${card.quantity} ${card.name}`);
        });
      }

      return lines.join("\n");
    }

    function openEditPanel() {
      if (!currentDeck) return;
      editDeckName.value = currentDeck.name || "";
      editDeckFormat.value = currentDeck.format || "modern";
      editDeckDescription.value = currentDeck.description || "";
      editDecklist.value = currentDeck.raw_decklist || deckToText(currentDeck.cards || []);
      editStatus.textContent = "";
      deckEditPanel.hidden = false;
      closeInspectPanel();
      editDeckName.focus();
    }

    function closeEditPanel() {
      deckEditPanel.hidden = true;
      editStatus.textContent = "";
      deckEditForm.reset();
    }

    function toggleEditPanel() {
      if (deckEditPanel.hidden) {
        openEditPanel();
      } else {
        closeEditPanel();
      }
    }

    function renderWarnings(warnings) {
      const activeWarnings = warnings.filter((warning) => String(warning || "").trim());
      document.querySelectorAll(".message-panel").forEach((panel) => panel.remove());
      if (!activeWarnings.length) return;

      const warningsPanel = document.createElement("section");
      warningsPanel.className = "message-panel";

      const heading = document.createElement("h2");
      heading.textContent = "Warnings";
      warningsPanel.append(heading);

      const warningsList = document.createElement("ul");

      activeWarnings.forEach((warning) => {
        const item = document.createElement("li");
        item.textContent = warning;
        warningsList.append(item);
      });

      warningsPanel.append(warningsList);
      deckViewShell.insertBefore(warningsPanel, deckPanel);
    }

    function manaSymbolClass(value) {
      const normalized = String(value || "")
        .trim()
        .toLowerCase()
        .replace(/\//g, "");

      const aliases = {
        "∞": "infinity",
        "½": "half",
      };

      return aliases[normalized] || normalized;
    }

    function manaColorClass(value) {
      const normalized = String(value || "").trim().toLowerCase();
      const colorClasses = {
        w: "white",
        u: "blue",
        b: "black",
        r: "red",
        g: "green",
        c: "colorless",
        s: "snow",
      };

      return colorClasses[normalized] || "generic";
    }

    function renderSpecialManaSymbol(value) {
      const normalized = String(value || "").trim();
      const upperValue = normalized.toUpperCase();
      const symbolEl = document.createElement("span");
      symbolEl.className = "mana-symbol mana-symbol-custom";
      symbolEl.setAttribute("role", "img");
      symbolEl.setAttribute("aria-label", normalized);
      symbolEl.title = normalized;

      if (upperValue === "S") {
        symbolEl.classList.add("mana-symbol-snow");
        const snowIcon = document.createElement("i");
        snowIcon.className = "mana-symbol-mark ms ms-s";
        symbolEl.append(snowIcon);
        return symbolEl;
      }

      const parts = normalized.split("/");
      const isPhyrexian = parts.at(-1)?.toUpperCase() === "P";

      if (isPhyrexian && parts.length === 2) {
        const colorClass = manaColorClass(parts[0]);
        symbolEl.classList.add(
          "mana-symbol-phyrexian",
          "mana-symbol-solid",
          `mana-solid-${colorClass}`,
        );

        const phyrexianIcon = document.createElement("i");
        phyrexianIcon.className = "mana-symbol-mark mana-symbol-phyrexian-mark ms ms-p";
        symbolEl.append(phyrexianIcon);
        return symbolEl;
      }

      if (isPhyrexian && parts.length === 3) {
        const leftClass = manaColorClass(parts[0]);
        const rightClass = manaColorClass(parts[1]);
        symbolEl.classList.add(
          "mana-symbol-phyrexian",
          "mana-symbol-phyrexian-dual",
          `mana-split-left-${leftClass}`,
          `mana-split-right-${rightClass}`,
        );

        const phyrexianIcon = document.createElement("i");
        phyrexianIcon.className = "mana-symbol-mark mana-symbol-phyrexian-mark ms ms-p";
        symbolEl.append(phyrexianIcon);
        return symbolEl;
      }

      if (parts.length !== 2) return null;

      const [left, right] = parts;
      const leftClass = manaColorClass(left);
      const rightClass = manaColorClass(right);
      symbolEl.classList.add(
        "mana-symbol-hybrid",
        `mana-split-left-${leftClass}`,
        `mana-split-right-${rightClass}`,
      );

      const leftMark = document.createElement("span");
      leftMark.className = "mana-symbol-half mana-symbol-half-left";
      if (/^\d+$/.test(left)) {
        leftMark.textContent = left;
      } else {
        const leftIcon = document.createElement("i");
        leftIcon.className = `mana-symbol-mark ms ms-${manaSymbolClass(left)}`;
        leftMark.append(leftIcon);
      }

      const rightMark = document.createElement("span");
      rightMark.className = "mana-symbol-half mana-symbol-half-right";
      if (/^\d+$/.test(right)) {
        rightMark.textContent = right;
      } else {
        const rightIcon = document.createElement("i");
        rightIcon.className = `mana-symbol-mark ms ms-${manaSymbolClass(right)}`;
        rightMark.append(rightIcon);
      }

      symbolEl.append(leftMark, rightMark);
      return symbolEl;
    }

    function renderManaCost(manaCost) {
      const wrapper = document.createElement("span");
      wrapper.className = "mana-cost";
      const symbols = String(manaCost || "").match(/\{[^}]+\}/g) || [];

      if (!symbols.length && manaCost) {
        wrapper.textContent = manaCost;
        return wrapper;
      }

      symbols.forEach((symbol) => {
        const value = symbol.replace(/[{}]/g, "");
        const specialSymbol = renderSpecialManaSymbol(value);
        if (specialSymbol) {
          wrapper.append(specialSymbol);
          return;
        }

        const symbolEl = document.createElement("i");
        symbolEl.className = `mana-symbol ms ms-cost ms-${manaSymbolClass(value)}`;
        symbolEl.setAttribute("role", "img");
        symbolEl.setAttribute("aria-label", value);
        symbolEl.title = value;
        wrapper.append(symbolEl);
      });

      return wrapper;
    }

    function renderDeck(cards) {
      deckSections.innerHTML = "";
      deckPanel.hidden = !cards.length;

      const groups = groupBySection(cards);
      const hasSideboard = Boolean((groups.sideboard || []).length);
      deckSections.classList.toggle("deck-sections-single", !hasSideboard);

      ["mainboard", "sideboard"].forEach((section) => {
        const cardsInSection = groups[section] || [];
        if (!cardsInSection.length) return;

        const sectionEl = document.createElement("section");
        sectionEl.className = `deck-section deck-section-${section}`;

        const heading = document.createElement("h2");
        heading.textContent = sectionLabel(section);
        sectionEl.append(heading);

        const table = document.createElement("table");
        table.className = "deck-table";

        const thead = document.createElement("thead");
        thead.innerHTML = "<tr><th>Qty</th><th>Name</th><th>Mana</th><th>Type</th></tr>";
        table.append(thead);

        const tbody = document.createElement("tbody");
        cardsInSection.forEach((card) => {
          const data = card.card_data || {};
          const row = document.createElement("tr");
          const cardKey = `${section}:${card.name}:${card.quantity}:${data.name || ""}`;
          row.className = "card-row";
          row.tabIndex = 0;
          row.setAttribute("role", "button");
          row.setAttribute("aria-label", `Inspect ${data.name || card.name}`);
          row.addEventListener("click", (event) => {
            event.stopPropagation();
            toggleInspect(card, cardKey);
          });
          row.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              toggleInspect(card, cardKey);
            }
          });

          const quantity = document.createElement("td");
          quantity.className = "card-qty";
          quantity.textContent = String(card.quantity);

          const name = document.createElement("td");
          const nameWrap = document.createElement("span");
          nameWrap.className = "card-name";
          const nameText = document.createElement("span");
          nameText.textContent = data.name || card.name;
          nameWrap.append(nameText, renderColorSquares(data.color_identity || []));
          name.append(nameWrap);

          const mana = document.createElement("td");
          mana.append(renderManaCost(data.mana_cost || ""));

          const type = document.createElement("td");
          type.textContent = data.type_line || "";

          row.append(quantity, name, mana, type);
          tbody.append(row);
        });
        table.append(tbody);
        sectionEl.append(table);
        deckSections.append(sectionEl);
      });
    }

    function closeInspectPanel() {
      inspectPanel.hidden = true;
      inspectedCardKey = null;
    }

    function toggleInspect(card, cardKey) {
      if (!inspectPanel.hidden && inspectedCardKey === cardKey) {
        closeInspectPanel();
        return;
      }

      inspectedCardKey = cardKey;
      showInspect(card);
    }

    function showInspect(card) {
      const data = card.card_data || {};
      inspectContent.innerHTML = "";

      const title = document.createElement("h2");
      title.textContent = data.name || card.name;
      inspectContent.append(title);

      if (data.image_uri) {
        const image = document.createElement("img");
        image.src = data.image_uri;
        image.alt = data.name || card.name;
        inspectContent.append(image);
      }

      const details = document.createElement("dl");
      [
        ["Quantity", card.quantity],
        ["Type", data.type_line || "Unknown"],
        ["Mana Value", data.cmc ?? ""],
      ].forEach(([label, value]) => {
        const dt = document.createElement("dt");
        dt.textContent = label;
        const dd = document.createElement("dd");
        dd.textContent = String(value);
        details.append(dt, dd);
      });

      const manaDt = document.createElement("dt");
      manaDt.textContent = "Mana Cost";
      const manaDd = document.createElement("dd");
      manaDd.append(renderManaCost(data.mana_cost || ""));
      details.append(manaDt, manaDd);

      const colorDt = document.createElement("dt");
      colorDt.textContent = "Color Identity";
      const colorDd = document.createElement("dd");
      colorDd.append(renderColorSquares(data.color_identity || []));
      details.append(colorDt, colorDd);
      inspectContent.append(details);

      if (data.oracle_text) {
        const oracleHeading = document.createElement("h3");
        oracleHeading.textContent = "Oracle Text:";
        inspectContent.append(oracleHeading);

        const oracle = document.createElement("p");
        oracle.className = "oracle-text";
        oracle.textContent = data.oracle_text;
        inspectContent.append(oracle);
      }

      if (data.scryfall_uri) {
        const link = document.createElement("a");
        link.className = "scryfall-link";
        link.href = data.scryfall_uri;
        link.target = "_blank";
        link.rel = "noreferrer";
        link.textContent = "View On Scryfall";
        inspectContent.append(link);
      }

      inspectPanel.hidden = false;
    }

    async function loadDeck() {
      if (!deckId) {
        deckTitle.textContent = "Deck Detail";
        deckMeta.textContent = "No deck id was provided.";
        deckPanel.hidden = true;
        return;
      }

      try {
        const response = await fetch(`${API_URL}/decks/${deckId}`);
        const deck = await response.json();
        if (!response.ok) {
          throw new Error(deck.detail || "Could not load deck.");
        }

        currentDeck = deck;
        renderTitle(deck);
        renderWarnings(deck.warnings || []);
        renderDeck(deck.cards || []);
      } catch (error) {
        deckTitle.textContent = "Deck Detail";
        deckMeta.textContent = error instanceof Error ? error.message : "Could not load deck.";
        deckPanel.hidden = true;
      }
    }

    async function saveDeck(event) {
      event.preventDefault();

      const decklist = editDecklist.value.trim();
      if (!decklist) {
        editStatus.textContent = "Paste a decklist first.";
        return;
      }

      saveDeckButton.disabled = true;
      editStatus.textContent = "Saving...";

      try {
        const response = await fetch(`${API_URL}/decks/${deckId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: editDeckName.value.trim(),
            format: editDeckFormat.value,
            description: editDeckDescription.value.trim(),
            decklist,
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not save deck.");
        }

        editStatus.textContent = "Saved. Reloading...";
        window.location.reload();
      } catch (error) {
        editStatus.textContent = error instanceof Error ? error.message : "Could not save deck.";
        saveDeckButton.disabled = false;
      }
    }

    async function deleteDeck() {
      if (!deckId) return;
      const confirmed = window.confirm("Delete this deck?");
      if (!confirmed) return;

      deleteDeckButton.disabled = true;

      try {
        const response = await fetch(`${API_URL}/decks/${deckId}`, { method: "DELETE" });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not delete deck.");
        }

        window.location.href = "/decks";
      } catch (error) {
        deckMeta.textContent = error instanceof Error ? error.message : "Could not delete deck.";
        deleteDeckButton.disabled = false;
      }
    }

    closeInspect.addEventListener("click", (event) => {
      event.stopPropagation();
      closeInspectPanel();
    });

    inspectPanel.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    document.addEventListener("click", () => {
      if (!inspectPanel.hidden) {
        closeInspectPanel();
      }
    });

    editDeckButton.addEventListener("click", toggleEditPanel);
    deckEditForm.addEventListener("submit", saveDeck);
    cancelEditButton.addEventListener("click", closeEditPanel);
    deleteDeckButton.addEventListener("click", deleteDeck);

    loadDeck();
  </script>
</BaseLayout>
