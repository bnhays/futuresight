---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Deck Detail | Future Sight">
  <section class="deck-view-shell">
    <div class="deck-view-header">
      <div>
        <h1 id="deck-title">Deck Detail</h1>
        <p id="deck-description" class="deck-detail-description" hidden></p>
        <p id="deck-meta">Loading deck...</p>
      </div>
      <div class="deck-actions">
        <a id="back-link" class="button-link action-button muted compact compact-action" href="/">Back</a>
        <button id="edit-deck" class="action-button success-button hollow-button compact-action" type="button">Edit</button>
        <a id="versions-deck" class="action-button version-button hollow-button compact-action" href="/decks">Versions</a>
        <button id="restore-version" class="action-button primary-button hollow-button compact-action" type="button" hidden>
          Restore as Latest
        </button>
        <button id="delete-deck" class="action-button danger-button hollow-button compact-action" type="button">Delete</button>
      </div>
    </div>

    <section id="deck-edit-panel" class="deck-edit-panel" hidden>
      <form id="deck-edit-form" class="import-form deck-edit-form">
        <div class="import-fields">
          <label>
            <span>Deck Name</span>
            <input id="edit-deck-name" name="name" type="text" autocomplete="off" />
          </label>

          <label>
            <span>Format</span>
            <select id="edit-deck-format" name="format">
              <option value="modern">Modern</option>
              <option value="standard">Standard</option>
              <option value="pioneer">Pioneer</option>
              <option value="legacy">Legacy</option>
              <option value="vintage">Vintage</option>
              <option value="pauper">Pauper</option>
              <option value="commander">Commander</option>
            </select>
          </label>
        </div>

        <label>
          <span>Description</span>
          <input id="edit-deck-description" name="description" type="text" maxlength="150" autocomplete="off" />
        </label>

        <label>
          <span>Thumbnail Card</span>
          <input id="edit-thumbnail-card-name" name="thumbnail_card_name" type="text" autocomplete="off" />
        </label>

        <label for="edit-decklist">Decklist</label>
        <textarea id="edit-decklist" name="decklist" rows="18" spellcheck="false"></textarea>

        <div class="form-actions">
          <div class="deck-actions">
            <button id="save-deck" class="action-button primary-button hollow-button" type="submit">Save</button>
            <button id="cancel-edit" class="action-button muted hollow-button" type="button">Back</button>
          </div>
          <span id="edit-status" role="status" aria-live="polite"></span>
        </div>
      </form>
    </section>

    <section id="deck-panel" class="deck-panel" hidden>
      <div id="deck-sections" class="deck-sections"></div>
    </section>

    <aside id="inspect-panel" class="inspect-panel" hidden>
      <button id="close-inspect" class="icon-button" type="button" aria-label="Close card inspection">x</button>
      <div id="inspect-content"></div>
    </aside>

    <div id="unsaved-quantity-bar" class="unsaved-quantity-bar" role="status" aria-live="polite" hidden>
      <span>You have unsaved changes</span>
      <div class="deck-actions">
        <button id="save-quantity-changes" class="action-button primary-button hollow-button" type="button">Save</button>
        <button id="discard-quantity-changes" class="action-button muted hollow-button" type="button">
          Discard changes
        </button>
      </div>
    </div>
  </section>

  <script>
    import { getListType, renderLandColorProduction, renderManaCurve } from "../../scripts/deck-stats.js";
    import { renderHoverPreview, showInspectCard } from "../../scripts/deck-inspect.js";
    import { renderMatchupHistory as renderDeckMatchupHistory } from "../../scripts/deck-matchups.js";
    import { cloneDeck, deckToText, groupBySection, normalizeText } from "../../scripts/deck-text.js";
    import { API_URL, formatDeckFormat, renderColorSquares as renderDeckColorSquares } from "../../scripts/deck-ui.js";
    import { renderManaCost } from "../../scripts/mana.js";

    const COLOR_ORDER = ["W", "U", "B", "R", "G", "C"];
    const COLOR_LABELS = {
      W: "White",
      U: "Blue",
      B: "Black",
      R: "Red",
      G: "Green",
      C: "Colorless",
    };

    const deckViewShell = document.querySelector(".deck-view-shell");
    const searchParams = new URLSearchParams(window.location.search);
    const deckId = searchParams.get("id");
    const selectedVersionId = searchParams.get("version_id");
    const backLink = document.querySelector("#back-link");
    const deckTitle = document.querySelector("#deck-title");
    const deckDescription = document.querySelector("#deck-description");
    const deckMeta = document.querySelector("#deck-meta");
    const deckPanel = document.querySelector("#deck-panel");
    const deckSections = document.querySelector("#deck-sections");
    const inspectPanel = document.querySelector("#inspect-panel");
    const inspectContent = document.querySelector("#inspect-content");
    const closeInspect = document.querySelector("#close-inspect");
    const editDeckButton = document.querySelector("#edit-deck");
    const versionsDeckButton = document.querySelector("#versions-deck");
    const restoreVersionButton = document.querySelector("#restore-version");
    const deleteDeckButton = document.querySelector("#delete-deck");
    const deckEditPanel = document.querySelector("#deck-edit-panel");
    const deckEditForm = document.querySelector("#deck-edit-form");
    const editDeckName = document.querySelector("#edit-deck-name");
    const editDeckFormat = document.querySelector("#edit-deck-format");
    const editDeckDescription = document.querySelector("#edit-deck-description");
    const editThumbnailCardName = document.querySelector("#edit-thumbnail-card-name");
    const editDecklist = document.querySelector("#edit-decklist");
    const saveDeckButton = document.querySelector("#save-deck");
    const cancelEditButton = document.querySelector("#cancel-edit");
    const editStatus = document.querySelector("#edit-status");
    const unsavedQuantityBar = document.querySelector("#unsaved-quantity-bar");
    const saveQuantityChangesButton = document.querySelector("#save-quantity-changes");
    const discardQuantityChangesButton = document.querySelector("#discard-quantity-changes");
    let currentDeck = null;
    let initialDeck = null;
    let inspectedCardKey = null;
    let matchupHistoryShowingAll = false;
    let activeMatchupId = null;
    let libraryDecks = null;

    function versionLabel(version) {
      return version.version_name ? `v${version.version_number} - ${version.version_name}` : `v${version.version_number}`;
    }

    function isPreviewMode(deck = currentDeck) {
      return Boolean(selectedVersionId || (deck?.selected_version_id && deck?.active_version_id && deck.selected_version_id !== deck.active_version_id));
    }

    function sectionLabel(section) {
      if (section === "sideboard") return "Sideboard";
      return "Mainboard";
    }

    function typeSectionLabel(type) {
      const labels = {
        Creature: "Creatures",
        Planeswalker: "Planeswalkers",
        Artifact: "Artifacts",
        Enchantment: "Enchantments",
        Instant: "Instants",
        Sorcery: "Sorceries",
        Land: "Lands",
      };
      return labels[type] || type || "Other";
    }

    function getIdentityColors(cards) {
      const colors = new Set();
      cards.forEach((card) => {
        const identity = card.card_data?.color_identity || [];
        identity.forEach((color) => colors.add(color));
      });
      return COLOR_ORDER.filter((color) => colors.has(color));
    }

    function renderColorSquares(colors) {
      return renderDeckColorSquares(colors, { order: COLOR_ORDER, labels: COLOR_LABELS });
    }

    function renderTitle(deck) {
      deckTitle.textContent = "";
      const colors = renderColorSquares(getIdentityColors(deck.cards || []));
      const titleText = document.createElement("span");
      titleText.textContent = deck.name || "Untitled Deck";

      if (colors.children.length) {
        deckTitle.append(colors);
      }
      deckTitle.append(titleText);
      deckDescription.textContent = deck.description || "";
      deckDescription.hidden = !deck.description;
      const versionText = deck.version_number ? ` | ${versionLabel(deck)}` : "";
      deckMeta.textContent = `Format: ${formatDeckFormat(deck.format || "modern")}${versionText}`;
    }

    function applyDeckMode(deck) {
      const previewMode = isPreviewMode(deck);
      backLink.href = previewMode && deckId ? `/decks/versions?id=${encodeURIComponent(deckId)}` : "/";
      backLink.textContent = previewMode ? "Versions" : "Back";
      versionsDeckButton.href = deckId ? `/decks/versions?id=${encodeURIComponent(deckId)}` : "/decks";
      editDeckButton.hidden = previewMode;
      deleteDeckButton.hidden = previewMode;
      versionsDeckButton.hidden = previewMode;
      restoreVersionButton.hidden = !previewMode || deck.selected_version_id === deck.active_version_id;
      if (previewMode) {
        closeEditPanel();
      }
      updateUnsavedQuantityBar();
    }

    function currentDecklistText() {
      if (!currentDeck) return "";
      return currentDeck.raw_decklist || deckToText(currentDeck.cards || []);
    }

    function hasEditChanges(decklist) {
      if (!currentDeck) return false;
      return (
        normalizeText(editDeckName.value) !== normalizeText(currentDeck.name) ||
        normalizeText(editDeckFormat.value) !== normalizeText(currentDeck.format || "modern") ||
        normalizeText(editDeckDescription.value) !== normalizeText(currentDeck.description) ||
        normalizeText(editThumbnailCardName.value) !== normalizeText(currentDeck.thumbnail_card_name) ||
        normalizeText(decklist) !== normalizeText(currentDecklistText())
      );
    }

    function hasUnsavedQuantityChanges() {
      if (!currentDeck || !initialDeck) return false;
      return deckToText(currentDeck.cards || []) !== deckToText(initialDeck.cards || []);
    }

    function updateUnsavedQuantityBar() {
      unsavedQuantityBar.hidden = isPreviewMode() || !hasUnsavedQuantityChanges();
    }

    function openEditPanel() {
      if (!currentDeck || isPreviewMode()) return;
      editDeckName.value = currentDeck.name || "";
      editDeckFormat.value = currentDeck.format || "modern";
      editDeckDescription.value = currentDeck.description || "";
      editThumbnailCardName.value = currentDeck.thumbnail_card_name || "";
      editDecklist.value = hasUnsavedQuantityChanges()
        ? deckToText(currentDeck.cards || [])
        : currentDecklistText();
      editStatus.textContent = "";
      deckEditPanel.hidden = false;
      closeInspectPanel();
      editDeckName.focus();
    }

    function closeEditPanel() {
      deckEditPanel.hidden = true;
      editStatus.textContent = "";
      deckEditForm.reset();
    }

    function toggleEditPanel() {
      if (deckEditPanel.hidden) {
        openEditPanel();
      } else {
        closeEditPanel();
      }
    }

    function renderWarnings(warnings) {
      const activeWarnings = warnings.filter((warning) => String(warning || "").trim());
      document.querySelectorAll(".message-panel").forEach((panel) => panel.remove());
      if (!activeWarnings.length) return;

      const warningsPanel = document.createElement("section");
      warningsPanel.className = "message-panel";

      const heading = document.createElement("h2");
      heading.textContent = "Warnings";
      warningsPanel.append(heading);

      const warningsList = document.createElement("ul");

      activeWarnings.forEach((warning) => {
        const item = document.createElement("li");
        item.textContent = warning;
        warningsList.append(item);
      });

      warningsPanel.append(warningsList);
      deckViewShell.insertBefore(warningsPanel, deckPanel);
    }

    function currentVersionId() {
      return currentDeck?.selected_version_id || currentDeck?.active_version_id || "";
    }

    function renderMatchupHistory() {
      return renderDeckMatchupHistory({
        apiUrl: API_URL,
        deckId,
        currentDeck,
        currentVersionId,
        activeMatchupId,
        libraryDecks,
        matchupHistoryShowingAll,
        cloneDeck,
        getCurrentDeck: () => currentDeck,
        setCurrentDeck: (deck) => {
          currentDeck = deck;
        },
        setInitialDeck: (deck) => {
          initialDeck = deck;
        },
        setActiveMatchupId: (matchupId) => {
          activeMatchupId = matchupId;
        },
        setLibraryDecks: (decks) => {
          libraryDecks = decks;
        },
        setMatchupHistoryShowingAll: (showingAll) => {
          matchupHistoryShowingAll = showingAll;
        },
        renderDeck,
      });
    }

    function normalizeCardName(name) {
      return String(name || "").trim().toLowerCase().replace(/\s+/g, " ");
    }

    function cardGroupKey(card) {
      return `${card.section || "mainboard"}:${normalizeCardName(card.name)}`;
    }

    function groupCardsByBackendLayout(cards) {
      const groupedCards = currentDeck?.grouped_cards;
      const cardsByKey = new Map();
      (cards || []).forEach((card) => {
        const key = cardGroupKey(card);
        const keyCards = cardsByKey.get(key) || [];
        keyCards.push(card);
        cardsByKey.set(key, keyCards);
      });

      const resolveCards = (groupCards) => (groupCards || [])
        .map((card) => cardsByKey.get(cardGroupKey(card))?.shift())
        .filter(Boolean);

      if (!groupedCards) {
        return {
          mainboard: [{ key: "Mainboard", label: "Mainboard", cards: (cards || []).filter((card) => (card.section || "mainboard") === "mainboard") }],
          sideboard: (cards || []).filter((card) => (card.section || "mainboard") === "sideboard"),
        };
      }

      return {
        mainboard: (groupedCards.mainboard || []).map((group) => ({
          key: group.key || group.label || "Other",
          label: group.label || typeSectionLabel(group.key),
          cards: resolveCards(group.cards),
        })),
        sideboard: resolveCards(groupedCards.sideboard),
      };
    }

    function findThumbnailCard(cards) {
      const thumbnailCardName = normalizeCardName(currentDeck?.thumbnail_card_name);
      if (!thumbnailCardName) return null;

      return (cards || []).find((card) => {
        const data = card.card_data || {};
        return [card.name, data.name].some((name) => normalizeCardName(name) === thumbnailCardName);
      }) || null;
    }

    function renderDeck(cards) {
      deckSections.innerHTML = "";
      deckPanel.hidden = !cards.length;
      let previewContent = null;

      function renderDeckSection(section, cardsInSection, headingText, options = {}) {
        if (!cardsInSection.length) return null;
        const { extraClass = "", typeKey = "" } = options;
        const isMainboardLandSection = section === "mainboard" && typeKey === "Land";

        const sectionEl = document.createElement("section");
        sectionEl.className = `deck-section deck-section-${section}${extraClass ? ` ${extraClass}` : ""}`;

        const heading = document.createElement("h2");
        heading.textContent = headingText;
        sectionEl.append(heading);

        const sectionContent = document.createElement("div");
        sectionContent.className = "deck-section-content";

        const table = document.createElement("table");
        table.className = `deck-table${isMainboardLandSection ? " deck-table-no-mana" : ""}`;

        const thead = document.createElement("thead");
        thead.innerHTML = isMainboardLandSection
          ? "<tr><th>#</th><th>Name</th><th>Type</th></tr>"
          : "<tr><th>#</th><th>Name</th><th>Mana</th><th>Type</th></tr>";
        table.append(thead);

        const tbody = document.createElement("tbody");
        cardsInSection.forEach((card) => {
          const data = card.card_data || {};
          const row = document.createElement("tr");
          const cardKey = `${section}:${headingText}:${card.name}:${card.quantity}:${data.name || ""}`;
          row.className = "card-row";
          row.tabIndex = 0;
          row.setAttribute("role", "button");
          row.setAttribute("aria-label", `Inspect ${data.name || card.name}`);
          row.addEventListener("click", (event) => {
            event.stopPropagation();
            toggleInspect(card, cardKey);
          });
          row.addEventListener("mouseenter", () => {
            renderHoverPreview(card, previewContent);
          });
          row.addEventListener("focus", () => {
            renderHoverPreview(card, previewContent);
          });
          row.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              toggleInspect(card, cardKey);
            }
          });

          const quantity = document.createElement("td");
          quantity.className = "card-qty";

          const quantityValue = document.createElement("span");
          quantityValue.className = "qty-value";
          quantityValue.textContent = String(card.quantity);

          if (isPreviewMode()) {
            quantity.append(quantityValue);
          } else {
            const quantityControl = document.createElement("div");
            quantityControl.className = "qty-control";
            quantityControl.addEventListener("click", (event) => {
              event.stopPropagation();
            });
            quantityControl.addEventListener("keydown", (event) => {
              event.stopPropagation();
            });

            const quantityButtons = document.createElement("div");
            quantityButtons.className = "qty-buttons";

            const incrementButton = document.createElement("button");
            incrementButton.className = "qty-button";
            incrementButton.type = "button";
            incrementButton.textContent = "+";
            incrementButton.setAttribute("aria-label", `Increase quantity for ${data.name || card.name}`);
            incrementButton.addEventListener("click", (event) => {
              event.stopPropagation();
              changeCardQuantity(card, 1);
            });

            const decrementButton = document.createElement("button");
            decrementButton.className = "qty-button";
            decrementButton.type = "button";
            decrementButton.textContent = "-";
            decrementButton.disabled = card.quantity <= 0;
            decrementButton.setAttribute("aria-label", `Decrease quantity for ${data.name || card.name}`);
            decrementButton.addEventListener("click", (event) => {
              event.stopPropagation();
              changeCardQuantity(card, -1);
            });

            quantityButtons.append(decrementButton, incrementButton);
            quantityControl.append(quantityButtons, quantityValue);
            quantity.append(quantityControl);
          }

          const name = document.createElement("td");
          const nameWrap = document.createElement("span");
          nameWrap.className = "card-name";
          const nameText = document.createElement("span");
          nameText.textContent = data.name || card.name;
          nameWrap.append(nameText);
          name.append(nameWrap);

          const type = document.createElement("td");
          const typeWrap = document.createElement("span");
          typeWrap.className = "card-type";
          const typeText = document.createElement("span");
          typeText.textContent = getListType(data.type_line || "");
          typeWrap.append(typeText, renderColorSquares(data.color_identity || []));
          type.append(typeWrap);

          if (isMainboardLandSection) {
            row.append(quantity, name, type);
          } else {
            const mana = document.createElement("td");
            mana.append(renderManaCost(data.mana_cost || ""));
            row.append(quantity, name, mana, type);
          }
          tbody.append(row);
        });
        table.append(tbody);
        sectionContent.append(table);
        sectionEl.append(sectionContent);
        return sectionEl;
      }

      const groups = groupBySection(cards);
      const backendGroups = groupCardsByBackendLayout(cards);
      const hasSideboard = Boolean((backendGroups.sideboard || []).length);
      deckSections.classList.toggle("deck-sections-single", !hasSideboard);
      deckSections.classList.toggle("deck-sections-with-sideboard", hasSideboard);

      const defaultPreviewCard = findThumbnailCard(cards) || (groups.mainboard || [])[0] || cards[0];
      if (defaultPreviewCard) {
        const previewColumn = document.createElement("div");
        previewColumn.className = "deck-preview-column";

        const preview = document.createElement("section");
        preview.className = "deck-card-preview-panel";

        const previewContentEl = document.createElement("div");
        previewContentEl.className = "deck-card-preview-content";
        preview.append(previewContentEl);
        const statsStack = document.createElement("div");
        statsStack.className = "deck-stats-stack";
        statsStack.append(
          renderManaCurve(currentDeck?.stats?.mana_curve),
          renderLandColorProduction(currentDeck?.stats?.land_color_production),
        );

        previewColumn.append(preview, statsStack);
        deckSections.append(previewColumn);
        previewContent = previewContentEl;
        renderHoverPreview(defaultPreviewCard, previewContent);
      }

      const mainboardTypes = backendGroups.mainboard || [];
      if (mainboardTypes.length) {
        const mainboardGrid = document.createElement("div");
        mainboardGrid.className = "mainboard-type-grid";
        const mainboardColumns = [document.createElement("div"), document.createElement("div")];
        mainboardColumns.forEach((column) => {
          column.className = "mainboard-type-column";
          mainboardGrid.append(column);
        });

        mainboardTypes.forEach((group, index) => {
          const sectionEl = renderDeckSection("mainboard", group.cards || [], group.label || typeSectionLabel(group.key), {
            extraClass: "deck-section-mainboard-type",
            typeKey: group.key,
          });
          if (sectionEl) mainboardColumns[index % mainboardColumns.length].append(sectionEl);
        });
        deckSections.append(mainboardGrid);
      }

      const sideboardSection = renderDeckSection("sideboard", backendGroups.sideboard || [], sectionLabel("sideboard"));
      if (sideboardSection) deckSections.append(sideboardSection);

      deckSections.append(renderMatchupHistory());
    }

    function changeCardQuantity(card, delta) {
      if (isPreviewMode()) return;
      card.quantity = Math.max(0, Number(card.quantity || 0) + delta);
      renderDeck(currentDeck.cards || []);
      updateUnsavedQuantityBar();
    }

    function closeInspectPanel() {
      inspectPanel.hidden = true;
      inspectedCardKey = null;
    }

    function toggleInspect(card, cardKey) {
      if (!inspectPanel.hidden && inspectedCardKey === cardKey) {
        closeInspectPanel();
        return;
      }

      inspectedCardKey = cardKey;
      showInspectCard({ card, inspectPanel, inspectContent, renderColorSquares });
    }

    async function loadDeck(versionId = new URLSearchParams(window.location.search).get("version_id")) {
      if (!deckId) {
        deckTitle.textContent = "Deck Detail";
        deckMeta.textContent = "No deck id was provided.";
        deckPanel.hidden = true;
        return;
      }

      try {
        const query = versionId ? `?version_id=${encodeURIComponent(versionId)}` : "";
        const response = await fetch(`${API_URL}/decks/${deckId}${query}`);
        const deck = await response.json();
        if (!response.ok) {
          throw new Error(deck.detail || "Could not load deck.");
        }

        currentDeck = deck;
        initialDeck = cloneDeck(deck);
        renderTitle(deck);
        applyDeckMode(deck);
        renderWarnings(deck.warnings || []);
        renderDeck(deck.cards || []);
        updateUnsavedQuantityBar();
      } catch (error) {
        deckTitle.textContent = "Deck Detail";
        deckMeta.textContent = error instanceof Error ? error.message : "Could not load deck.";
        deckPanel.hidden = true;
      }
    }

    async function saveQuantityChanges() {
      if (!currentDeck || !deckId) return;
      if (!hasUnsavedQuantityChanges()) return;

      const changeNote = window.prompt("Change note", "Updated card quantities.") || "";
      saveQuantityChangesButton.disabled = true;
      discardQuantityChangesButton.disabled = true;

      try {
        const response = await fetch(`${API_URL}/decks/${deckId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: currentDeck.name || "",
            format: currentDeck.format || "modern",
            description: currentDeck.description || "",
            thumbnail_card_name: currentDeck.thumbnail_card_name || "",
            change_note: changeNote.trim(),
            base_version_id: currentDeck.selected_version_id || currentDeck.active_version_id || "",
            decklist: deckToText(currentDeck.cards || []),
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not save deck.");
        }

        window.location.href = `/decks/view?id=${encodeURIComponent(deckId)}`;
      } catch (error) {
        deckMeta.textContent = error instanceof Error ? error.message : "Could not save deck.";
        saveQuantityChangesButton.disabled = false;
        discardQuantityChangesButton.disabled = false;
      }
    }

    function discardQuantityChanges() {
      if (!initialDeck) return;
      currentDeck = cloneDeck(initialDeck);
      closeInspectPanel();
      renderDeck(currentDeck.cards || []);
      updateUnsavedQuantityBar();
      saveQuantityChangesButton.disabled = false;
      discardQuantityChangesButton.disabled = false;
    }

    async function saveDeck(event) {
      event.preventDefault();

      const decklist = editDecklist.value.trim();
      if (!decklist) {
        editStatus.textContent = "Paste a decklist first.";
        return;
      }

      if (!hasEditChanges(decklist)) {
        editStatus.textContent = "No changes to save.";
        return;
      }

      const changeNote = window.prompt("Change note", "") || "";
      saveDeckButton.disabled = true;
      editStatus.textContent = "Saving...";

      try {
        const response = await fetch(`${API_URL}/decks/${deckId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: editDeckName.value.trim(),
            format: editDeckFormat.value,
            description: editDeckDescription.value.trim(),
            thumbnail_card_name: editThumbnailCardName.value.trim(),
            change_note: changeNote.trim(),
            base_version_id: currentDeck?.selected_version_id || currentDeck?.active_version_id || "",
            decklist,
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not save deck.");
        }

        editStatus.textContent = "Saved. Loading new version...";
        window.location.href = `/decks/view?id=${encodeURIComponent(deckId)}`;
      } catch (error) {
        editStatus.textContent = error instanceof Error ? error.message : "Could not save deck.";
        saveDeckButton.disabled = false;
      }
    }

    async function restoreViewedVersion() {
      if (!currentDeck?.selected_version_id || !deckId) return;
      const confirmed = window.confirm(`Restore ${versionLabel(currentDeck)} as the latest version?`);
      if (!confirmed) return;

      const changeNote = window.prompt(
        "Change note",
        `Restored version ${currentDeck.version_number || ""}.`.trim(),
      ) || "";

      restoreVersionButton.disabled = true;

      try {
        const response = await fetch(
          `${API_URL}/decks/${deckId}/versions/${currentDeck.selected_version_id}/restore`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ change_note: changeNote.trim() }),
          },
        );
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not restore version.");
        }

        window.location.href = `/decks/view?id=${encodeURIComponent(deckId)}`;
      } catch (error) {
        deckMeta.textContent = error instanceof Error ? error.message : "Could not restore version.";
        restoreVersionButton.disabled = false;
      }
    }

    async function deleteDeck() {
      if (!deckId) return;
      const confirmed = window.confirm("Delete this deck?");
      if (!confirmed) return;

      deleteDeckButton.disabled = true;

      try {
        const response = await fetch(`${API_URL}/decks/${deckId}`, { method: "DELETE" });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not delete deck.");
        }

        window.location.href = "/decks";
      } catch (error) {
        deckMeta.textContent = error instanceof Error ? error.message : "Could not delete deck.";
        deleteDeckButton.disabled = false;
      }
    }

    closeInspect.addEventListener("click", (event) => {
      event.stopPropagation();
      closeInspectPanel();
    });

    inspectPanel.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    document.addEventListener("click", () => {
      if (!inspectPanel.hidden) {
        closeInspectPanel();
      }
    });

    editDeckButton.addEventListener("click", toggleEditPanel);
    restoreVersionButton.addEventListener("click", restoreViewedVersion);
    deckEditForm.addEventListener("submit", saveDeck);
    cancelEditButton.addEventListener("click", closeEditPanel);
    deleteDeckButton.addEventListener("click", deleteDeck);
    saveQuantityChangesButton.addEventListener("click", saveQuantityChanges);
    discardQuantityChangesButton.addEventListener("click", discardQuantityChanges);

    loadDeck();
  </script>
</BaseLayout>
