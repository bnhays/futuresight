---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Future Sight">
  <section class="import-shell">
    <div class="import-layout">
      <form id="import-form" class="import-form">
        <div class="import-fields">
          <label>
            <span>Deck Name</span>
            <input id="deck-name" name="name" type="text" autocomplete="off" placeholder="Deck name" />
          </label>

          <label>
            <span>Format</span>
            <select id="deck-format" name="format">
              <option value="modern" selected>Modern</option>
              <option value="standard">Standard</option>
              <option value="pioneer">Pioneer</option>
              <option value="legacy">Legacy</option>
              <option value="vintage">Vintage</option>
              <option value="pauper">Pauper</option>
            </select>
          </label>
        </div>

        <label>
          <span>Description</span>
          <input
            id="deck-description"
            name="description"
            type="text"
            maxlength="150"
            autocomplete="off"
            placeholder="Deck description"
          />
        </label>

        <label for="decklist">Decklist</label>
        <textarea
          id="decklist"
          name="decklist"
          rows="16"
          spellcheck="false"
          placeholder={`4 Lightning Bolt
4x Counterspell
Sideboard
2 Negate`}
        ></textarea>
        <div class="form-actions">
          <button id="import-button" type="submit">Import</button>
          <span id="import-status" role="status" aria-live="polite"></span>
        </div>
      </form>

      <div class="import-side-panels">
        <aside class="recent-decks-panel" aria-labelledby="recent-decks-heading">
          <div class="panel-heading">
            <h2 id="recent-decks-heading">Recent Decks</h2>
            <a class="button-link compact" href="/decks">See all</a>
          </div>
          <div id="recent-decks-list" class="recent-decks-list" aria-live="polite">
            <p class="empty-state">Loading decks...</p>
          </div>
        </aside>

        <aside class="random-card-panel" aria-labelledby="random-card-heading">
          <div class="panel-heading">
            <h2 id="random-card-heading">Random Card Art</h2>
            <button id="refresh-card-art" class="action-button muted hollow-button compact-action" type="button">Refresh</button>
          </div>
          <div id="random-card-art" class="random-card-art" aria-live="polite">
            <p class="empty-state">Loading card art...</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

    const form = document.querySelector("#import-form");
    const deckName = document.querySelector("#deck-name");
    const deckFormat = document.querySelector("#deck-format");
    const deckDescription = document.querySelector("#deck-description");
    const textarea = document.querySelector("#decklist");
    const button = document.querySelector("#import-button");
    const status = document.querySelector("#import-status");
    const recentDecksList = document.querySelector("#recent-decks-list");
    const randomCardArt = document.querySelector("#random-card-art");
    const refreshCardArtButton = document.querySelector("#refresh-card-art");

    function formatFormat(format) {
      if (!format) return "";
      return format.charAt(0).toUpperCase() + format.slice(1);
    }

    function formatUpdatedAt(updatedAt) {
      if (!updatedAt) return "";
      const date = new Date(updatedAt);
      if (Number.isNaN(date.getTime())) return "";
      return date.toLocaleString(undefined, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
    }

    function renderColorSquares(colors) {
      const wrapper = document.createElement("span");
      wrapper.className = "color-squares";

      (colors || []).forEach((color) => {
        const square = document.createElement("span");
        square.className = `color-square color-${String(color).toLowerCase()}`;
        wrapper.append(square);
      });

      return wrapper;
    }

    function renderRecentDecks(decks) {
      recentDecksList.innerHTML = "";

      if (!decks.length) {
        const empty = document.createElement("p");
        empty.className = "empty-state";
        empty.textContent = "No saved decks yet.";
        recentDecksList.append(empty);
        return;
      }

      decks.forEach((deck) => {
        const link = document.createElement("a");
        link.className = "recent-deck-link";
        link.href = `/decks/view?id=${encodeURIComponent(deck.id)}`;

        const header = document.createElement("span");
        header.className = "recent-deck-header";

        const name = document.createElement("span");
        name.className = "recent-deck-name";
        name.textContent = deck.name || "Untitled Deck";

        const updatedAt = document.createElement("span");
        updatedAt.className = "recent-deck-updated";
        updatedAt.textContent = formatUpdatedAt(deck.updated_at);

        const meta = document.createElement("span");
        meta.className = "recent-deck-meta";
        meta.append(
          renderColorSquares(deck.color_identity || []),
          document.createTextNode(formatFormat(deck.format || "unknown")),
        );

        const description = document.createElement("span");
        description.className = "recent-deck-description";
        description.textContent = deck.description || "";
        description.hidden = !deck.description;

        header.append(name, updatedAt);
        link.append(header, description, meta);
        recentDecksList.append(link);
      });
    }

    async function loadRecentDecks() {
      try {
        const response = await fetch(`${API_URL}/decks?limit=5`);
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not load recent decks.");
        }
        renderRecentDecks(Array.isArray(data) ? data : []);
      } catch {
        recentDecksList.innerHTML = "";
        const error = document.createElement("p");
        error.className = "empty-state";
        error.textContent = "Recent decks are unavailable.";
        recentDecksList.append(error);
      }
    }

    function shuffle(items) {
      return items
        .map((item) => ({ item, sort: Math.random() }))
        .sort((a, b) => a.sort - b.sort)
        .map(({ item }) => item);
    }

    function getCardsWithArt(deck) {
      return (deck.cards || []).filter((card) => card.card_data?.image_uri);
    }

    function renderRandomCardArt(deck, card) {
      randomCardArt.innerHTML = "";

      const image = document.createElement("img");
      image.src = card.card_data.image_uri;
      image.alt = card.card_data.name || card.name || "Random card art";

      const source = document.createElement("p");
      source.className = "random-card-source";
      source.textContent = `From ${deck.name || "Untitled Deck"}`;

      randomCardArt.append(image, source);
    }

    function renderRandomCardMessage(message) {
      randomCardArt.innerHTML = "";
      const empty = document.createElement("p");
      empty.className = "empty-state";
      empty.textContent = message;
      randomCardArt.append(empty);
    }

    async function loadRandomCardArt() {
      refreshCardArtButton.disabled = true;
      renderRandomCardMessage("Loading card art...");

      try {
        const response = await fetch(`${API_URL}/decks`);
        const decks = await response.json();
        if (!response.ok) {
          throw new Error(decks.detail || "Could not load decks.");
        }

        const shuffledDecks = shuffle(Array.isArray(decks) ? decks : []);
        if (!shuffledDecks.length) {
          renderRandomCardMessage("No saved decks yet.");
          return;
        }

        for (const deckSummary of shuffledDecks) {
          const detailResponse = await fetch(`${API_URL}/decks/${deckSummary.id}`);
          const deck = await detailResponse.json();
          if (!detailResponse.ok) continue;

          const cardsWithArt = getCardsWithArt(deck);
          if (!cardsWithArt.length) continue;

          const card = cardsWithArt[Math.floor(Math.random() * cardsWithArt.length)];
          renderRandomCardArt(deck, card);
          return;
        }

        renderRandomCardMessage("Saved decks do not have card art yet.");
      } catch {
        renderRandomCardMessage("Card art is unavailable.");
      } finally {
        refreshCardArtButton.disabled = false;
      }
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const decklist = textarea.value.trim();
      if (!decklist) {
        status.textContent = "Paste a decklist first.";
        return;
      }

      button.disabled = true;
      status.textContent = "Parsing...";

      try {
        const response = await fetch(`${API_URL}/decks/import`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: deckName.value.trim(),
            format: deckFormat.value,
            description: deckDescription.value.trim(),
            decklist,
          }),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.detail || "Could not import decklist.");
        }

        if (data.id && data.cards?.length) {
          status.textContent = "Saved. Opening deck view...";
          window.location.href = `/decks/view?id=${encodeURIComponent(data.id)}`;
        } else {
          status.textContent = "No cards found.";
        }
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Could not import decklist.";
      } finally {
        button.disabled = false;
      }
    });

    refreshCardArtButton.addEventListener("click", loadRandomCardArt);

    loadRecentDecks();
    loadRandomCardArt();
  </script>
</BaseLayout>
